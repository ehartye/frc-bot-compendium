  "story": {
    "bet": [],
    "demand": [],
    "auto": [
      {
        "text": "A four-piece auto scores three on L4 and then one on L2.",
        "basis": "team",
        "src": [
          "s9"
        ]
      },
      {
        "text": "A Chief Delphi post says 1706 also ran an auto of one L4 coral and three algae into the net.",
        "basis": "observer",
        "src": [
          "s11"
        ]
      }
    ],
    "cycle": [
      {
        "text": "Coral goes from the feeder station into a three-sided funnel that takes it on any of three sides. The operator picks side, level and reef position, and auto align lines the robot up. The manipulator can hold coral and algae at once and score both, or remove an algae and then score a coral at any level.",
        "basis": "team",
        "src": [
          "s9"
        ]
      }
    ],
    "endgame": [
      {
        "text": "The driver drives into the cage, a mechanism latches one bar of it, and the climber, which is the funnel's back wall, pulls the cage into the funnel.",
        "basis": "team",
        "src": [
          "s9"
        ]
      }
    ],
    "fallback": [],
    "gave_up": [],
    "changed": [
      {
        "text": "The interview is from a regional; the championship version is not described.",
        "basis": "observer",
        "src": [
          "s9"
        ]
      },
      {
        "text": "After the last event the team added the algae intake and changed the climber to grab one bar, then added a deflector plate to center the cage. The wire chain kept breaking or leaving the robot until a constant force spring pulled it down. Plates went under the robot after it ran up on an algae.",
        "basis": "team",
        "src": [
          "s9"
        ]
      }
    ],
    "outcome": [
      {
        "text": "35-10-1 in official play; finalist in the Curie division; ranked 18 of the pooled top 20 (OPR 100.33, Curie).",
        "basis": "record",
        "src": [
          "s1",
          "s2"
        ]
      }
    ]
  },
  "functions": [
    {
      "name": "Three-sided funnel",
      "pieces": [
        "coral"
      ],
      "solves": [
        {
          "text": "Take coral from any of three sides, also around defense",
          "basis": "team",
          "src": [
            "s9"
          ]
        }
      ],
      "does": [
        "acquire"
      ],
      "type": "three-sided dampened funnel",
      "serves": [
        "reef-l1",
        "reef-branches"
      ],
      "facts": [
        {
          "text": "It takes coral at the feeder station on any of three sides",
          "basis": "team",
          "src": [
            "s9"
          ]
        },
        {
          "text": "Damping material lets coral be thrown in hard and still settle",
          "basis": "team",
          "src": [
            "s9"
          ]
        }
      ]
    },
    {
      "name": "Algae intake",
      "pieces": [
        "algae"
      ],
      "solves": [
        {
          "text": "Go out, take an algae and come back in quickly",
          "basis": "team",
          "src": [
            "s9"
          ]
        }
      ],
      "does": [
        "acquire"
      ],
      "type": "rack-driven roller intake",
      "serves": [
        "net"
      ],
      "facts": [
        {
          "text": "A lightweight intake on a curved rack with a NEO 550 and a polycarbonate roller with tape that helps center the algae",
          "basis": "team",
          "src": [
            "s9"
          ]
        },
        {
          "text": "Added after the previous event",
          "basis": "team",
          "src": [
            "s9"
          ]
        }
      ]
    },
    {
      "name": "Elevator",
      "pieces": [
        "coral"
      ],
      "solves": [
        {
          "text": "Keep the height it reaches consistent",
          "basis": "team",
          "src": [
            "s9"
          ]
        }
      ],
      "does": [
        "position"
      ],
      "type": "continuous-style cascading elevator, as the team calls it, with linked sides",
      "serves": [
        "reef-l1",
        "reef-branches"
      ],
      "facts": [
        {
          "text": "Like the team's 2024 robot but with a wider belt and one gearbox at the bottom linking both sides",
          "basis": "team",
          "src": [
            "s9"
          ]
        }
      ],
      "cost": [
        {
          "text": "The wire chain kept breaking, shooting out or flipping into the funnel until a constant force spring on a roller pulled it down",
          "basis": "team",
          "src": [
            "s9"
          ]
        }
      ]
    },
    {
      "name": "Manipulator",
      "pieces": [
        "coral",
        "algae"
      ],
      "solves": [
        {
          "text": "Hold a coral and an algae at the same time and score both",
          "basis": "team",
          "src": [
            "s9"
          ]
        }
      ],
      "does": [
        "retain",
        "deliver"
      ],
      "type": "flip-over coral and algae manipulator",
      "serves": [
        "reef-l1",
        "reef-branches",
        "net"
      ],
      "facts": [
        {
          "text": "All three motors sit in the carriage instead of on the manipulator, to save weight",
          "basis": "team",
          "src": [
            "s9"
          ]
        },
        {
          "text": "It flips over the top to score in the barge without turning the robot around",
          "basis": "team",
          "src": [
            "s9"
          ]
        }
      ]
    },
    {
      "name": "Climber",
      "solves": [
        {
          "text": "Bring the cage in without moving the funnel out of the way",
          "basis": "team",
          "src": [
            "s9"
          ]
        }
      ],
      "does": [
        "endgame"
      ],
      "type": "cage-latching climber at the funnel back",
      "serves": [
        "cage"
      ],
      "facts": [
        {
          "text": "It grabs only one bar of the cage, which makes alignment easier for the driver",
          "basis": "team",
          "src": [
            "s9"
          ]
        },
        {
          "text": "A polycarbonate deflector centers the cage, then wheels bring it in",
          "basis": "team",
          "src": [
            "s9"
          ]
        }
      ]
    },
    {
      "name": "Safe move and auto align",
      "pieces": [
        "coral"
      ],
      "solves": [
        {
          "text": "Move elevator and arm without collisions and line up on the reef",
          "basis": "team",
          "src": [
            "s9"
          ]
        }
      ],
      "does": [
        "sense"
      ],
      "type": "interlocked motion and operator-chosen alignment",
      "serves": [
        "reef-branches"
      ],
      "facts": [
        {
          "text": "Safe move checks listed cases, such as the elevator blocked at some arm angles, and moves one mechanism first so the other can go",
          "basis": "team",
          "src": [
            "s9"
          ]
        },
        {
          "text": "The operator picks side, level and reef position, and the robot auto-aligns to it",
          "basis": "team",
          "src": [
            "s9"
          ]
        },
        {
          "text": "Auto align lets the driver shoot more precisely and from farther back",
          "basis": "team",
          "src": [
            "s9"
          ]
        }
      ]
    },
    {
      "name": "Truss frame and undermounted electronics",
      "solves": [
        {
          "text": "Make room for electronics and wiring underneath, away from impacts",
          "basis": "team",
          "src": [
            "s9"
          ]
        }
      ],
      "does": [
        "structure"
      ],
      "type": "custom frame pieces with electronics underneath",
      "serves": [],
      "facts": [
        {
          "text": "Truss pieces replace a 2x1 cross member, cut off the corners by the swerve and join the two corners",
          "basis": "team",
          "src": [
            "s9"
          ]
        },
        {
          "text": "Printed grommets protect wires from sharp metal edges",
          "basis": "team",
          "src": [
            "s9"
          ]
        }
      ]
    }
  ],
