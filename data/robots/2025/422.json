  "story": {
    "bet": [],
    "demand": [],
    "auto": [],
    "cycle": [],
    "endgame": [],
    "fallback": [],
    "gave_up": [],
    "changed": [
      {
        "text": "The intake pivot carried an algae roller at the first few events and a coral ground intake later. Pose estimation failed on day one of the first event, leaving no auto score and no autos; after a replay that night the team moved to 6328's estimator and has had no localization issues since.",
        "basis": "team",
        "src": [
          "s11",
          "s15",
          "s12"
        ]
      }
    ],
    "outcome": [
      {
        "text": "60-8-0 in official play; finalist in the Newton division; ranked 16 of the pooled top 20 (OPR 101.45, Newton).",
        "basis": "record",
        "src": [
          "s1",
          "s2"
        ]
      }
    ]
  },
  "functions": [
    {
      "name": "Coral ground intake",
      "pieces": [
        "coral"
      ],
      "solves": [
        {
          "text": "Balance rigidity and flex so a flap both holds coral and lets it through",
          "basis": "team",
          "src": [
            "s13"
          ]
        }
      ],
      "does": [
        "acquire",
        "retain",
        "transfer"
      ],
      "type": "ground intake with a passive polycarbonate flap",
      "serves": [],
      "facts": [
        {
          "text": "The flap is 1/16 in polycarbonate",
          "basis": "team",
          "src": [
            "s13"
          ]
        },
        {
          "text": "The flap is just stiff enough to hold coral at low motor current, and higher current pushes the coral right through",
          "basis": "team",
          "src": [
            "s13"
          ]
        }
      ]
    },
    {
      "name": "Intake pivot",
      "does": [
        "structure"
      ],
      "type": "SplineXL extrusion press-fit on machined hubs",
      "serves": [],
      "facts": [
        {
          "text": "Hubs were bought in the OD size and machined down to the ID size for a press fit",
          "basis": "team",
          "src": [
            "s11"
          ]
        },
        {
          "text": "A drilled and tapped set screw was added when the coral intake replaced the algae roller",
          "basis": "team",
          "src": [
            "s11"
          ]
        }
      ]
    },
    {
      "name": "Climber mount",
      "does": [
        "endgame",
        "structure"
      ],
      "type": "tube plug and keyed gearbox plates",
      "serves": [
        "cage"
      ],
      "facts": [
        {
          "text": "The belly pan bolts to a hidden 2x2 tube plug",
          "basis": "team",
          "src": [
            "s14"
          ]
        },
        {
          "text": "The ends of the gearbox plates key into the belly pan",
          "basis": "team",
          "src": [
            "s14"
          ]
        }
      ]
    },
    {
      "name": "Battery strap",
      "does": [
        "structure"
      ],
      "type": "nylon strap with a zip tie as the buckle",
      "serves": [],
      "facts": [
        {
          "text": "A billet part was made earlier in the season, but the robot ran out of weight to install it",
          "basis": "team",
          "src": [
            "s14"
          ]
        }
      ]
    },
    {
      "name": "Pose estimation",
      "solves": [
        {
          "text": "The 2025 WPILib estimator often got stuck when bad reprojections were picked, with no good camera filtering at the time",
          "basis": "team",
          "src": [
            "s12"
          ]
        }
      ],
      "does": [
        "sense"
      ],
      "type": "AprilTag pose estimation with 6328's estimator",
      "serves": [],
      "facts": [
        {
          "text": "It locks into position way quicker than before",
          "basis": "team",
          "src": [
            "s12"
          ]
        },
        {
          "text": "Replaying the match that night showed the new code would have worked",
          "basis": "team",
          "src": [
            "s12"
          ]
        },
        {
          "text": "It had worked at a practice field; at the event, more light and the lowest shutter speed gave many more vision measurements while moving",
          "basis": "team",
          "src": [
            "s15",
            "s12"
          ]
        },
        {
          "text": "The team also used that estimator in 2024, and thinks it handles past tag measurements better, without math to show it",
          "basis": "team",
          "src": [
            "s12"
          ]
        }
      ],
      "cost": [
        {
          "text": "It takes more CPU time, though a little tuning made that acceptable",
          "basis": "team",
          "src": [
            "s12"
          ]
        }
      ]
    },
    {
      "name": "Elevator control",
      "solves": [
        {
          "text": "Move smoothly up and down through the stages",
          "basis": "team",
          "src": [
            "s16"
          ]
        }
      ],
      "does": [
        "position"
      ],
      "type": "PID on built-in motor encoders",
      "serves": [],
      "facts": [
        {
          "text": "Position uses only the encoders in the Krakens, with no motion profile: PID plus a gravity term",
          "basis": "team",
          "src": [
            "s16"
          ]
        },
        {
          "text": "Three gain slots switch with the stage, so the gravity term grows on the second and third stages",
          "basis": "team",
          "src": [
            "s16"
          ]
        }
      ],
      "cost": [
        {
          "text": "Gains chosen for quick movement make it loud",
          "basis": "team",
          "src": [
            "s16"
          ]
        }
      ]
    },
    {
      "name": "Tie rods",
      "does": [
        "structure"
      ],
      "type": "carbon fiber tubes with turned end caps",
      "serves": [],
      "facts": [
        {
          "text": "Custom aluminum end caps, turned on a lathe, are epoxied into the tubes",
          "basis": "team",
          "src": [
            "s17"
          ]
        }
      ]
    },
    {
      "name": "Batteries",
      "does": [
        "structure"
      ],
      "type": "match batteries",
      "serves": [],
      "facts": [
        {
          "text": "They failed after day two of the district championship, with 10 or more brownouts per match in eliminations; some were borrowed for the last few matches",
          "basis": "team",
          "src": [
            "s18"
          ]
        },
        {
          "text": "A reply to a photo of a corroded battery says its case had cracked slightly, likely from overtightened terminal nuts",
          "basis": "observer",
          "src": [
            "s19"
          ]
        }
      ]
    }
  ],
  "decisions": [
    {
      "choice": "Switch to 6328's pose estimator during the first event",
      "because": "replay of the failed match showed it worked",
      "instead_of": "the 2025 WPILib pose estimator",
      "cost": "more CPU time, which a little tuning made acceptable",
      "basis": "team",
      "src": [
        "s15",
        "s12"
      ]
    },
    {
      "choice": "Set screw in the intake pivot hub",
      "because": "it is more secure for the coral intake",
      "instead_of": "the press fit alone, good enough for the algae roller",
      "basis": "team",
      "src": [
        "s11"
      ]
    },
    {
      "choice": "Strap and zip tie for the battery",
      "because": "the robot ran out of weight",
      "instead_of": "a billet part already made",
      "basis": "team",
      "src": [
        "s14"
      ]
    }
  ],
