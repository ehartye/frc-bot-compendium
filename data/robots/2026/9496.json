  "story": {
    "bet": [
      {
        "text": "Minimize degrees of freedom: a simple robot leaves more time to tune. The team counts none on this one.",
        "basis": "team",
        "src": [
          "s11"
        ]
      }
    ],
    "demand": [
      {
        "text": "In February, before its first event, the team was optimizing for a very fast auto through the trench and fast, straight cycles to the neutral zone.",
        "basis": "team",
        "src": [
          "s20"
        ]
      }
    ],
    "auto": [
      {
        "text": "A maneuver in auto makes the unpowered intake drop out, and the hopper slides out with it.",
        "basis": "team",
        "src": [
          "s4"
        ]
      },
      {
        "text": "A forum post cites coordinated sweeps with 1690 and 2813 in Galileo qualification 87, a match it puts at 899 points.",
        "basis": "observer",
        "src": [
          "s16"
        ]
      }
    ],
    "cycle": [
      {
        "text": "Fuel goes over the bumper, along a powered roller floor and an indexer, into a fixed shooter. The robot aims itself at the AprilTag (a later post: from its tracked position), motor speed sets the shot, and LEDs count down the shift.",
        "basis": "team",
        "src": [
          "s4",
          "s18"
        ]
      },
      {
        "text": "In a mic'd match, calls to the driver include intake, pass, fill up, over the bump and shoot.",
        "basis": "observer",
        "src": [
          "s7"
        ]
      }
    ],
    "endgame": [],
    "fallback": [
      {
        "text": "Automatic aiming can be switched off if something goes wrong.",
        "basis": "team",
        "src": [
          "s4"
        ]
      },
      {
        "text": "In a mic'd match someone recalls an earlier final with the trench blocked: the robot went over the bump and lost vision for a couple of seconds.",
        "basis": "observer",
        "src": [
          "s7"
        ]
      }
    ],
    "gave_up": [
      {
        "text": "Ball agitation was not great, so the intake rollers pulse in and out while shooting. There were a few moments when folding the intake up would have avoided fouls and some cards.",
        "basis": "team",
        "src": [
          "s11"
        ]
      },
      {
        "text": "It spent the whole season near maximum weight and loaded into its district championship overweight.",
        "basis": "team",
        "src": [
          "s11"
        ]
      }
    ],
    "changed": [
      {
        "text": "By its third event the intake was at about version four or five and the hopper at four. Since the event before, its gear ratio had changed to about 2:1; an added net sped up intaking.",
        "basis": "team",
        "src": [
          "s4"
        ]
      },
      {
        "text": "A forum list calls it a rebuild.",
        "basis": "observer",
        "src": [
          "s14"
        ]
      },
      {
        "text": "The team says it evolved instead, its shooter widening twice into a true drum.",
        "basis": "team",
        "src": [
          "s17"
        ]
      }
    ],
    "outcome": [
      {
        "text": "70-13-0 in official play; ranked 14 of the pooled top 20 (OPR 307.15, Galileo).",
        "basis": "record",
        "src": [
          "s1",
          "s2"
        ]
      }
    ]
  },
  "functions": [
    {
      "name": "Intake",
      "pieces": [
        "fuel"
      ],
      "solves": [
        {
          "text": "Collect fuel over the bumper with no powered deployment",
          "basis": "team",
          "src": [
            "s4",
            "s11"
          ]
        }
      ],
      "does": [
        "acquire"
      ],
      "type": "passive drop-out over-bumper roller intake",
      "serves": [
        "hub"
      ],
      "facts": [
        {
          "text": "Two rollers, the first covered in cat tongue, and two motors",
          "basis": "team",
          "src": [
            "s4"
          ]
        },
        {
          "text": "Gear ratio about 2:1",
          "basis": "team",
          "src": [
            "s4"
          ]
        },
        {
          "text": "A kicker based a lot on 254's helps prevent beaching",
          "basis": "team",
          "src": [
            "s4"
          ]
        },
        {
          "text": "At its first event two X44s drove the two rollers",
          "basis": "team",
          "src": [
            "s27"
          ]
        },
        {
          "text": "A commenter on the CAD notes that the indexer helps deploy it",
          "basis": "observer",
          "src": [
            "s28"
          ]
        }
      ],
      "cost": [
        {
          "text": "It cannot fold up, which in a few moments would have avoided fouls and some cards",
          "basis": "team",
          "src": [
            "s11"
          ]
        }
      ]
    },
    {
      "name": "Hopper",
      "pieces": [
        "fuel"
      ],
      "solves": [
        {
          "text": "Slide out with the intake during auto, with no power",
          "basis": "team",
          "src": [
            "s4"
          ]
        }
      ],
      "does": [
        "retain"
      ],
      "type": "unpowered sliding hopper",
      "serves": [
        "hub"
      ],
      "facts": [
        {
          "text": "An added net increased intake speed",
          "basis": "team",
          "src": [
            "s4"
          ]
        }
      ]
    },
    {
      "name": "Roller floor and indexer",
      "pieces": [
        "fuel"
      ],
      "solves": [
        {
          "text": "Carry fuel from the intake to the shooter",
          "basis": "team",
          "src": [
            "s4"
          ]
        }
      ],
      "does": [
        "transfer"
      ],
      "type": "powered roller floor",
      "serves": [
        "hub"
      ],
      "facts": [
        {
          "text": "Mostly inspired by 254's 2017 robot",
          "basis": "team",
          "src": [
            "s4"
          ]
        },
        {
          "text": "About two Krakens run the first part and one X60 runs the indexer, with two passive rolling guides",
          "basis": "team",
          "src": [
            "s4"
          ]
        },
        {
          "text": "Pulsing the intake rollers in and out while shooting agitates the fuel and empties the hopper more completely, removing some dead spots near the intake",
          "basis": "team",
          "src": [
            "s4",
            "s11",
            "s34"
          ]
        },
        {
          "text": "In February, before its first event: rollers of 7/8 in outer diameter with 1/16 in silicone, 2.1254 in apart, on a floor at 10 degrees, an angle that fit over the swerve",
          "basis": "team",
          "src": [
            "s29",
            "s30",
            "s31"
          ]
        },
        {
          "text": "In February, compression was 0.375 in at the indexer and 0.5 in at the top floor roller, and floor, indexer and shooter ran at about 1:1",
          "basis": "team",
          "src": [
            "s32",
            "s33"
          ]
        }
      ],
      "cost": [
        {
          "text": "Agitation was not great",
          "basis": "team",
          "src": [
            "s11"
          ]
        },
        {
          "text": "In early February it jammed with one X60; a second X60 and turning off current limits, which had been very low, cured it, except on an extremely low battery",
          "basis": "team",
          "src": [
            "s35",
            "s36"
          ]
        },
        {
          "text": "A commenter highly recommends against removing the current limits entirely, since many motors at high stator current tax the battery",
          "basis": "observer",
          "src": [
            "s53"
          ]
        }
      ]
    },
    {
      "name": "Shooter",
      "pieces": [
        "fuel"
      ],
      "solves": [
        {
          "text": "Give consistent shots with nothing to change but motor speed and robot aim",
          "basis": "team",
          "src": [
            "s4"
          ]
        }
      ],
      "does": [
        "deliver"
      ],
      "type": "fixed tube shooter with brass flywheels",
      "serves": [
        "hub"
      ],
      "facts": [
        {
          "text": "About four X60s drive it through belts",
          "basis": "team",
          "src": [
            "s4"
          ]
        },
        {
          "text": "An aluminum tube with a brass flywheel on each side",
          "basis": "team",
          "src": [
            "s4"
          ]
        },
        {
          "text": "No adjustable hood and no kicker",
          "basis": "team",
          "src": [
            "s4"
          ]
        },
        {
          "text": "February version: one shaft with four motors, about 5.2 lb of flywheels and wheels, and 0.675 in of compression plus 0.25 in of foam",
          "basis": "team",
          "src": [
            "s40",
            "s33"
          ]
        },
        {
          "text": "The hood angle went from 30 to 34 degrees before its first event",
          "basis": "team",
          "src": [
            "s41",
            "s42"
          ]
        },
        {
          "text": "Flywheel speed comes from a calibrated, interpolated table of distance to the hub; fuel feeds only when drum speed and alignment are both met",
          "basis": "team",
          "src": [
            "s18",
            "s43"
          ]
        },
        {
          "text": "Faster feeding cut the spread in range seen in early videos",
          "basis": "team",
          "src": [
            "s44",
            "s45",
            "s46"
          ]
        },
        {
          "text": "In February the belt had no tensioner; designed center distances left it slightly loose, so tape thickened the idler, and printed guides kept fuel 0.85 in from each side, away from the pulleys",
          "basis": "team",
          "src": [
            "s47"
          ]
        }
      ]
    },
    {
      "name": "Automatic aiming",
      "solves": [
        {
          "text": "Aim the robot so the driver only has to shoot",
          "basis": "team",
          "src": [
            "s4"
          ]
        }
      ],
      "does": [
        "sense",
        "position"
      ],
      "type": "pose-based turn-to-aim with AprilTag cameras",
      "serves": [
        "hub"
      ],
      "facts": [
        {
          "text": "Two cameras, one for the side and one higher up, keep the robot's pose",
          "basis": "team",
          "src": [
            "s4"
          ]
        },
        {
          "text": "It can be turned off",
          "basis": "team",
          "src": [
            "s4"
          ]
        },
        {
          "text": "One AprilTag camera at its first event, a side camera added by its third, and four cameras that season: Arducam OV2311 with PhotonVision on two Orange Pi 5s",
          "basis": "team",
          "src": [
            "s48",
            "s18",
            "s49"
          ]
        },
        {
          "text": "It aims at the angle its tracked position gives, so it can still shoot if the camera is blocked just before, though driving with it blocked would probably drift the pose; aim keeps refining while shooting",
          "basis": "team",
          "src": [
            "s50",
            "s18"
          ]
        }
      ],
      "cost": [
        {
