  "decisions": [
    {
      "choice": "Unpowered intake deployment",
      "because": "fewer degrees of freedom keep the robot simple and leave time to tune, and there was no weight or space for another motor and chain",
      "instead_of": "a powered intake",
      "cost": "weaker ball agitation, and some fouls and cards that folding it would have avoided",
      "basis": "team",
      "src": [
        "s11"
      ]
    },
    {
      "choice": "Fixed shooter with no adjustable hood",
      "because": "the team minimizes degrees of freedom to keep its robots simple; shots change with motor speed and robot aim alone, which it calls extremely consistent",
      "basis": "team",
      "src": [
        "s4",
        "s11"
      ]
    },
    {
      "choice": "Vertical C bumper mounts",
      "because": "the normal WCP bumper cones did not fit the design",
      "cost": "bumpers came off the tube when hit, so an internal latch was added to join the halves; one side lifts and the other drops when hit",
      "basis": "team",
      "src": [
        "s25"
      ]
    },
    {
      "choice": "Daisy-chained CAN",
      "because": "on CAN FD, star wiring past a certain length brought reflections and stubs too long, a headache to fix on its robot SUBLYME",
      "instead_of": "star CAN",
      "basis": "team",
      "src": [
        "s26"
      ]
    },
    {
      "choice": "No divider in the middle of the floor rollers",
      "because": "testing showed more balls per second without it; the shooter's middle plate went too, with no loss of accuracy seen (February)",
      "instead_of": "a dividing plate",
      "basis": "team",
      "src": [
        "s37",
        "s38",
        "s39"
      ]
    },
    {
      "choice": "Shoot back over the hopper",
      "because": "it allows a very quick auto run through the trench with minimal rotation and fast straight cycles, and is a bit harder to block; 254's 2017 robot did the same",
      "instead_of": "shooting the other way, which is better for cleaning up its own zone",
      "basis": "team",
      "src": [
        "s20"
      ]
    }
