          ]
        }
      ]
    }
  ],
  "decisions": [
    {
      "choice": "Rebuild the robot mid-season",
      "because": "the strategy was mostly right but Blitz could not execute it well enough",
      "instead_of": "iterating Blitz",
      "cost": "about three weeks for design, assembly and bring-up",
      "basis": "team",
      "src": [
        "s7",
        "s8",
        "s16"
      ]
    },
    {
      "choice": "Aggressively simple design drawn from 254, 1678 and 6328",
      "because": "the timeline was extreme and those architectures had already proven themselves by Week 2",
      "cost": "an architecture that was not familiar to the team",
      "basis": "team",
      "src": [
        "s7"
      ]
    },
