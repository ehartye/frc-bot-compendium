  "story": {
    "bet": [
      {
        "text": "Maximum throughput from a self-sufficient, aggressively simple scorer with a hopper, instead of a passer that relies on its alliance partners.",
        "basis": "team",
        "src": [
          "s7"
        ]
      }
    ],
    "demand": [
      {
        "text": "Two weeks into the competition season the team put throughput first and valued being self-sufficient, because elevating partners had not been enough against strong scoring robots. It judged that winning auto is not vital but that what the robot does in auto is. It also wanted a hopper, to resist defense in a hub-scoring role.",
        "basis": "team",
        "src": [
          "s7"
        ]
      }
    ],
    "auto": [
      {
        "text": "Point-to-point paths are built for two center sweeps: under the trench on the way out to preserve odometry, over the bump on the way back, where relocalizing is easier.",
        "basis": "team",
        "src": [
          "s7"
        ]
      },
      {
        "text": "A rotation turns the camera to the back hub tags before the bump, to recover from center-line collisions.",
        "basis": "team",
        "src": [
          "s19"
        ]
      }
    ],
    "cycle": [
      {
        "text": "The intake fills the hopper and sensors preload the feeder. With a valid tag seen and tolerances met, the feeder runs and the intake retracts to compress fuel toward the shooter. In passing mode it aims at the closest corner of the alliance zone.",
        "basis": "team",
        "src": [
          "s7"
        ]
      }
    ],
    "endgame": [
      {
        "text": "The binder describes no climber; in its extracted text, 'Climb' falls in the no-design-effort list, whose table columns were lost.",
        "basis": "inference",
        "src": [
          "s7"
        ]
      }
    ],
    "fallback": [
      {
        "text": "A failsafe mode fires from set positions with preset flywheel speeds and hood angles, without vision. The tag requirement can be overridden by hand, and the wheels can lock in an X under defense.",
        "basis": "team",
        "src": [
          "s7"
        ]
      }
    ],
    "gave_up": [
      {
        "text": "The team set aside its 'Familiar' and 'Lightweight' objectives.",
        "basis": "team",
        "src": [
          "s7"
        ]
      },
      {
        "text": "A reply that reads as the team's says prototyping was skipped and driver practice limited.",
        "basis": "observer",
        "src": [
          "s18"
        ]
      },
      {
        "text": "In one member's view, localization was the biggest limit at Champs.",
        "basis": "team",
        "src": [
          "s20"
        ]
      },
      {
        "text": "An outside list notes a small hopper and no net.",
        "basis": "observer",
        "src": [
          "s23"
        ]
      },
      {
        "text": "A commentator says 4065's defense held it to essentially one hopper in a finals 2 shift.",
        "basis": "observer",
        "src": [
          "s10"
        ]
      }
    ],
    "changed": [
      {
        "text": "Blitz, a passer with two side four-bar intakes, a serpentine path and no hopper, was limited by intake and shoot-on-the-move speed.",
        "basis": "team",
        "src": [
          "s7",
          "s19",
          "s6"
        ]
      },
      {
        "text": "The team's interview and a team post date the rebuild decision to after the first event; its blog speaks of the first two competitions.",
        "basis": "team",
        "src": [
          "s19",
          "s16",
          "s8"
        ]
      },
      {
        "text": "Breaking deploy chains were Blitz's biggest intake fault, a team post says.",
        "basis": "team",
        "src": [
          "s21"
        ]
      },
      {
        "text": "A reply that reads as the team's says the four-bar broke every match.",
        "basis": "observer",
        "src": [
          "s18"
        ]
      }
    ],
    "outcome": [
      {
        "text": "53-23-0 in official play; won the Newton division; championship finalist; captain of the Newton alliance on Einstein; ranked 2 of the pooled top 20 (OPR 408.46, Newton).",
        "basis": "record",
        "src": [
          "s1",
          "s2"
        ]
      }
    ]
  },
  "functions": [
    {
      "name": "Drivebase",
      "solves": [
        {
          "text": "Stay fast and robust, with a smooth underside that does not get stuck on fuel",
          "basis": "team",
          "src": [
            "s7"
          ]
        }
      ],
      "does": [
        "drive"
      ],
      "type": "swerve",
      "serves": [],
      "facts": [
        {
          "text": "27.5 x 27 in chassis, modified from Blitz with the modules rotated 90 degrees",
          "basis": "team",
          "src": [
            "s7"
          ]
        },
        {
          "text": "MK5n modules with R1 gearing, the lowest ratio, to minimize current draw",
          "basis": "team",
          "src": [
            "s7"
          ]
        },
        {
          "text": "Four Kraken X60 drive, four X44 steer",
          "basis": "team",
          "src": [
            "s7"
          ]
        },
        {
          "text": "Custom lowering blocks and a polycarbonate bellypan keep fuel from getting under the robot and stop it getting stuck",
          "basis": "team",
          "src": [
            "s7"
          ]
        }
      ]
    },
    {
      "name": "Intake",
      "pieces": [
        "fuel"
      ],
      "solves": [
        {
          "text": "Withstand impacts by strength; a powered bottom roller was added so that it could intake at maximum robot speed",
          "basis": "team",
          "src": [
            "s7"
          ]
        }
      ],
      "does": [
        "acquire"
      ],
      "type": "slap-down over-the-bumper roller intake",
      "serves": [
        "hub"
      ],
      "facts": [
        {
          "text": "Takes up to this many at once",
          "basis": "team",
          "src": [
            "s7"
          ],
          "value": 4,
          "unit": "fuel"
        },
        {
          "text": "Deployed by one Kraken X60 with a #35 chain final reduction",
          "basis": "team",
          "src": [
            "s7"
          ]
        },
        {
          "text": "Deploy gear ratio",
          "basis": "team",
          "src": [
            "s7"
          ],
          "value": 40,
          "unit": ":1"
        },
        {
          "text": "One 2 in main roller and two 1.25 in lower dead-axle rollers, on two Kraken X60",
          "basis": "team",
          "src": [
            "s7"
          ]
        },
        {
          "text": "Billet side plates about 0.6 in thick, split in two sections joined by five bolts each",
          "basis": "team",
          "src": [
            "s7"
          ]
        },
        {
          "text": "A 2 x 2 box-tube 'bash bar' sits over the main roller to protect it",
          "basis": "team",
          "src": [
            "s7"
          ]
        },
        {
          "text": "A championship interview calls it a four-bar once; the binder says a slap-down replaced the four-bar",
          "basis": "team",
          "src": [
            "s7",
            "s19"
          ]
        }
      ],
      "cost": [
        {
          "text": "A team post says it was massively overdesigned to make sure that it would not break",
          "basis": "team",
          "src": [
            "s21"
          ]
        }
      ]
    },
    {
      "name": "Hopper",
      "pieces": [
        "fuel"
      ],
      "solves": [
        {
          "text": "Resist defense and separate scoring from driving and shooting on the move",
          "basis": "team",
          "src": [
            "s7"
          ]
        }
      ],
      "does": [
        "retain"
      ],
      "type": "one-piece polycarbonate hopper, passively deployed",
      "serves": [
        "hub"
      ],
      "facts": [
        {
          "text": "Stows above the shooter and slides out on bearings when the intake deploys",
          "basis": "team",
          "src": [
            "s7"
          ]
        },
        {
          "text": "Catchers lock it out so that it cannot be pushed back into the shooter",
          "basis": "team",
          "src": [
            "s7"
          ]
        },
        {
          "text": "Capacity given in the team's championship interview (captioned), about",
          "basis": "team",
          "src": [
            "s19"
          ],
          "value": 55,
          "unit": "balls"
        },
        {
          "text": "An outside list says just over 50 balls",
          "basis": "observer",
          "src": [
            "s23"
          ]
        },
        {
          "text": "Light-tinted panels show how much fuel is inside; sheet metal brackets with flush nuts let damaged panels be replaced easily",
          "basis": "team",
          "src": [
            "s7"
          ]
        }
      ],
      "cost": [
        {
          "text": "An outside list says the hopper is small for a dumper, so the robot must cycle extremely quickly",
          "basis": "observer",
          "src": [
            "s23"
          ]
        }
      ]
    },
    {
      "name": "Feeder",
      "pieces": [
        "fuel"
      ],
      "solves": [
        {
          "text": "Raise throughput over the serpentine path, which moved fuel needlessly before the shot",
          "basis": "team",
          "src": [
            "s7"
          ]
        }
      ],
      "does": [
        "transfer"
      ],
      "type": "inclined powered roller floor",
      "serves": [
        "hub"
      ],
      "facts": [
        {
          "text": "Incline",
          "basis": "team",
          "src": [
            "s7"
          ],
          "value": 15,
          "unit": "deg"
        },
        {
          "text": "Ten 1.25 in rollers and an indexing roller with nine 2.25 in 35A compliant wheels, four balls wide",
          "basis": "team",
          "src": [
            "s7"
          ]
        },
        {
          "text": "All chained together at 1:1 on four Kraken X60",
          "basis": "team",
          "src": [
            "s7"
          ]
        },
        {
          "text": "Teflon-covered backing boards in the tower and hopper improved consistency and throughput, the team says",
          "basis": "team",
          "src": [
            "s7"
          ]
        },
        {
          "text": "A front backing board slides balls into the shooter more quickly",
          "basis": "team",
          "src": [
            "s7"
          ]
        }
      ]
    },
    {
      "name": "Preload",
      "pieces": [
        "fuel"
      ],
      "solves": [
        {
          "text": "Fit more fuel into each hopper cycle",
          "basis": "team",
          "src": [
            "s19"
          ]
        }
      ],
      "does": [
        "sense",
        "transfer"
      ],
      "type": "two CANrange sensors",
      "serves": [
        "hub"
      ],
      "facts": [
        {
          "text": "When the hopper sensor trips, at around 80% full, the feeder runs until its own sensor trips, just before the flywheel",
          "basis": "team",
          "src": [
            "s19"
          ]
        },
        {
          "text": "Adds two rows of four per hopper cycle",
          "basis": "team",
          "src": [
            "s19"
          ],
          "value": 8,
          "unit": "balls"
        }
      ]
    },
    {
      "name": "Shooter",
      "pieces": [
        "fuel"
      ],
      "solves": [
        {
          "text": "Keep exit velocity consistent across many shots",
          "basis": "team",
          "src": [
            "s7"
          ]
        }
      ],
      "does": [
        "deliver"
      ],
      "type": "four-wide drum shooter with hood",
      "serves": [
        "hub"
      ],
      "facts": [
        {
          "text": "4 in aluminum drum with 1.5 in hood rollers",
          "basis": "team",
          "src": [
            "s7"
          ]
        },
        {
          "text": "Flywheel overdrive ratio",
          "basis": "team",
          "src": [
            "s7"
          ],
          "value": 6.7,
          "unit": ":1"
        },
        {
          "text": "Sustained maximum over a full hopper, as the team states it",
          "basis": "team",
          "src": [
            "s7"
          ],
          "value": 34,
          "unit": "balls/s"
        },
        {
          "text": "The interviewer and an outside list say about 35 balls/s",
          "basis": "observer",
          "src": [
            "s19",
            "s23"
          ]
        },
        {
          "text": "The flywheel started at a lower ratio, was raised with the original stainless wheel for the district championship, and ended as a custom balanced brass one; a less extreme overspeed would also work",
          "basis": "team",
          "src": [
            "s21"
          ]
        },
        {
          "text": "Aluminum supports hold the backing plates where feeder rollers once were, per a reply that reads as the team's",
          "basis": "observer",
          "src": [
            "s18"
          ]
        }
      ],
      "cost": [
        {
          "text": "Rollers used before the backing plates made exit velocity inconsistent and spread the shot",
          "basis": "team",
          "src": [
            "s19"
          ]
        }
      ]
    },
    {
      "name": "Vision relocalization",
      "solves": [
        {
          "text": "Keep the robot's position good enough to aim after collisions",
          "basis": "team",
          "src": [
            "s19"
          ]
        }
      ],
      "does": [
        "sense"
      ],
      "type": "one front Limelight 4 measuring tag distance",
      "serves": [
        "hub"
      ],
      "facts": [
        {
          "text": "Distance comes from the pixel height of the tag, looked up in a table",
          "basis": "team",
          "src": [
            "s19"
          ]
        },
        {
          "text": "Averaging the tag's height to its middle fixed distortion when the hub tags are seen at an angle",
          "basis": "team",
          "src": [
            "s19"
          ]
        },
        {
          "text": "Tag distance resets odometry translation, which sets shot parameters and corrects the auto path",
          "basis": "team",
          "src": [
            "s7"
          ]
        },
        {
          "text": "The robot may not shoot without a visible tag unless overridden",
          "basis": "team",
          "src": [
            "s7"
          ]
        }
      ],
      "cost": [
        {
          "text": "One team member says that with more time the team would have put a lot of effort into more cameras, since localization was the biggest limit at Champs",
          "basis": "team",
          "src": [
            "s20"
          ]
        }
      ]
    },
    {
      "name": "Base Subsystems and state machine",
      "solves": [
        {
          "text": "Program only the logic specific to each subsystem",
          "basis": "team",
          "src": [
            "s7"
          ]
        }
      ],
      "does": [
        "sense"
      ],
      "type": "code templates with finite state machines",
      "serves": [],
      "facts": [
        {
          "text": "Servo and roller parent classes generate motor interfaces and logging from IDs, ratios and limits",
          "basis": "team",
          "src": [
            "s7"
          ]
        },
        {
          "text": "Bring-up to basic functionality took about (captioned)",
          "basis": "team",
          "src": [
            "s19"
          ],
          "value": 2,
          "unit": "h"
        },
        {
          "text": "A button pushes a wanted state to the superstructure, which passes wanted states to subsystems",
          "basis": "team",
          "src": [
            "s7"
          ]
        }
      ]
    },
    {
      "name": "Pass-on-the-move",
      "pieces": [
        "fuel"
      ],
      "does": [
        "sense",
        "deliver"
      ],
      "type": "pose extrapolation with a lookup table",
      "serves": [],
      "facts": [
        {
          "text": "Pose is extrapolated forward by a time-of-flight constant, then a passing table and a rotation calculation give shooter speed and rotation",
          "basis": "team",
          "src": [
            "s7"
          ]
        }
      ]
    },
    {
      "name": "Multi-ratio gearboxes",
      "solves": [
        {
          "text": "Change speeds quickly without remaking gearbox plates",
          "basis": "team",
          "src": [
            "s7"
          ]
        }
      ],
      "does": [
        "structure"
      ],
      "type": "gearboxes designed for several ratios",
      "serves": [],
      "facts": [
        {
          "text": "All gearboxes accept multiple ratios, so speeds change without remaking plates",
          "basis": "team",
          "src": [
