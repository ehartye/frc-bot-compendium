  "story": {
    "outcome": [
      {
        "text": "55-14-0 in official play; won the Curie division; captain of the Curie alliance on Einstein; ranked 6 of the pooled top 20 (OPR 77.17, Curie).",
        "basis": "record",
        "src": [
          "s1",
          "s2"
        ]
      }
    ],
    "bet": [
      {
        "text": "A 24 by 24 in frame, a rule on the team's priority list that dictated much of the design.",
        "basis": "team",
        "src": [
          "s12"
        ]
      }
    ],
    "cycle": [
      {
        "text": "The driver holds a button to snap to 90 degree headings, one for the human player station and one to come back and score. A color mode, yellow for cones and purple for cubes, sets the elevator and wrist positions and the wheel direction.",
        "basis": "team",
        "src": [
          "s10"
        ]
      },
      {
        "text": "A commenter reports videos of 12 second cycles, weeks before the February reveal.",
        "basis": "observer",
        "src": [
          "s14"
        ]
      }
    ],
    "changed": [
      {
        "text": "The team first tried the NEO version of its swerve modules, found it difficult in code, and moved to the Falcon version.",
        "basis": "team",
        "src": [
          "s10"
        ]
      }
    ]
  },
  "functions": [
    {
      "name": "Drivetrain",
      "does": [
        "drive"
      ],
      "type": "swerve",
      "serves": [],
      "facts": [
        {
          "text": "Frame side, square",
          "basis": "team",
          "src": [
            "s12"
          ],
          "value": 24,
          "unit": "in"
        },
        {
          "text": "SDS MK4i modules with Falcon motors",
          "basis": "team",
          "src": [
            "s3",
            "s10"
          ]
        },
        {
          "text": "Earlier robots felt at or near the frame perimeter limit, so the small frame was a huge departure",
          "basis": "team",
          "src": [
            "s12"
          ]
        }
      ]
    },
    {
      "name": "Tipping elevator",
      "pieces": [
        "cone",
        "cube"
      ],
      "does": [
        "position"
      ],
      "type": "two-position tipping, two-stage cascade elevator",
      "serves": [],
      "facts": [
        {
          "text": "Described as super rigid, consistent and very simple",
          "basis": "team",
          "src": [
            "s10"
          ]
        },
        {
          "text": "A commenter says a giant pneumatic cylinder tilts it, which let the drivebase stay 24 by 24 in for balancing",
          "basis": "observer",
          "src": [
            "s13"
          ]
        }
      ]
    },
    {
      "name": "Intake with a wrist",
      "pieces": [
        "cone",
        "cube"
      ],
      "does": [
        "acquire",
        "retain"
      ],
      "type": "dual-motor roller intake on a wrist",
      "serves": [],
      "facts": [
        {
          "text": "Inspired at first by the Everybot intake, with the wheel orientation changed",
          "basis": "team",
          "src": [
            "s10"
          ]
        },
        {
          "text": "A hand-tied addition helps keep cubes intact",
          "basis": "team",
          "src": [
            "s10"
          ]
        },
        {
          "text": "Wheels turn one way for cones and the other for cubes",
          "basis": "team",
          "src": [
            "s10"
          ]
        }
      ]
    },
    {
      "name": "Snap to heading",
      "solves": [
        {
          "text": "Let the driver worry much less about alignment",
          "basis": "team",
          "src": [
            "s10"
          ]
        }
      ],
      "does": [
        "sense"
      ],
      "type": "button-held 90 degree headings",
      "serves": [],
      "facts": [
        {
          "text": "Cardinal directions on the driver controller turn the robot while it drives",
          "basis": "team",
          "src": [
            "s10"
          ]
        }
      ]
    },
    {
      "name": "Color modes",
      "pieces": [
        "cone",
        "cube"
      ],
      "does": [
        "sense"
      ],
      "type": "two-mode presets",
      "serves": [],
      "facts": [
        {
          "text": "Yellow for cones and purple for cubes set the wrist and elevator heights",
          "basis": "team",
          "src": [
            "s10"
          ]
        }
      ]
    }
  ],
  "decisions": [
