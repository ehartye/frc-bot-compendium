  "story": {
    "outcome": [
      {
        "text": "58-12-0 in official play; ranked 13 of the pooled top 20 (OPR 73.73, Galileo).",
        "basis": "record",
        "src": [
          "s1",
          "s2"
        ]
      }
    ],
    "bet": [],
    "demand": [
      {
        "text": "After kickoff the team set goals: be very light and fast, pick up a cone in any orientation, and score high and mid. Cones came first, because the team thought other teams might not pick them up as efficiently.",
        "basis": "team",
        "src": [
          "s11"
        ]
      }
    ],
    "cycle": [
      {
        "text": "Lights show the human player which piece to hand out, and the same change switches the intake mode. The telescoping arm picks up pieces standing or lying flat, cones from the front or the back, and scores high and mid.",
        "basis": "team",
        "src": [
          "s11"
        ]
      }
    ],
    "endgame": [],
    "changed": [
      {
        "text": "By the Dallas event the cone intake was on its 11th version and the cube intake on its fourth. After the first gripper version the team stopped using block CAD for it and modeled changes directly. It kept improving the robot between events.",
        "basis": "team",
        "src": [
          "s11",
          "s13",
          "s5"
        ]
      }
    ]
  },
  "functions": [
    {
      "name": "Swerve drive",
      "does": [
        "drive"
      ],
      "type": "swerve",
      "serves": [],
      "facts": [
        {
          "text": "REV MAXSwerve modules, which the team says were inspired by its own custom modules of the year before",
          "basis": "team",
          "src": [
            "s11"
          ]
        }
      ]
    },
    {
      "name": "Pivoting telescoping arm",
      "pieces": [
        "cone",
        "cube"
      ],
      "solves": [
        {
          "text": "Reach the mid and high rows with something lighter, and believed faster, than an elevator",
          "basis": "team",
          "src": [
            "s11"
          ]
        }
      ],
      "does": [
        "position"
      ],
      "type": "pivoting telescoping arm",
      "serves": [
        "grid-mid",
        "grid-high"
      ],
      "facts": [
        {
          "text": "Range of motion, about",
          "basis": "team",
          "src": [
            "s11"
          ],
          "value": 180,
          "unit": "deg"
        },
        {
          "text": "Picks up cones from the front and the back",
          "basis": "team",
          "src": [
            "s11"
          ]
        },
        {
          "text": "A hole pattern in the belt tensioner changes tension in small steps; it was set once and left",
          "basis": "team",
          "src": [
            "s11"
          ]
        },
        {
          "text": "Unsigned reply that reads as the team's: two turnbuckles tension the pivot chain by turning the whole gearbox about the round cross tube at the tower base",
          "basis": "observer",
          "src": [
            "s4"
          ]
        },
        {
          "text": "Unsigned reply that reads as the team's: the gearbox mount is a slip fit on that tube, with collars to hold it along the tube",
          "basis": "observer",
          "src": [
            "s4"
          ]
        }
      ],
      "cost": [
        {
          "text": "Unsigned reply that reads as the team's: the arm's speed puts a lot of force in the chain, so its tension would need tweaking",
          "basis": "observer",
          "src": [
            "s4"
          ]
        }
      ]
    },
    {
      "name": "Intake and wrist",
      "pieces": [
        "cone",
        "cube"
      ],
      "solves": [
        {
          "text": "Take any piece from the floor in any orientation",
          "basis": "team",
          "src": [
            "s11"
          ]
        }
      ],
      "does": [
        "acquire",
        "retain",
        "position"
      ],
      "type": "rotating wrist with separate cone and cube intakes",
      "serves": [
        "grid-mid",
        "grid-high"
      ],
      "facts": [
        {
          "text": "Range of motion, about",
          "basis": "team",
          "src": [
            "s11"
          ],
          "value": 360,
          "unit": "deg"
        },
        {
          "text": "Turning the wrist lets it take cones that are standing up as well as on their side",
          "basis": "team",
          "src": [
            "s11"
          ]
        }
      ],
      "cost": [
        {
          "text": "Eleven cone versions and four cube versions by the first event, with most effort on cones",
          "basis": "team",
          "src": [
            "s11"
          ]
        }
      ]
    },
    {
      "name": "A-frame and cables",
      "solves": [
        {
          "text": "Stop the robot wobbling as it drives, at low weight",
          "basis": "team",
          "src": [
            "s11"
          ]
        }
      ],
      "does": [
        "structure"
      ],
      "type": "A-frame braced by tension cables",
      "serves": [],
      "facts": [
        {
          "text": "The A-frame sits slightly off center from the base for balance",
          "basis": "team",
          "src": [
            "s11"
          ]
        },
        {
          "text": "Whole robot without ballast, in an unsigned reply that reads as the team's, about",
          "basis": "observer",
          "src": [
            "s6"
          ],
          "value": 60,
          "unit": "lb"
        },
        {
          "text": "Whole robot with ballast at that time, in the same reply",
          "basis": "observer",
          "src": [
            "s6"
          ],
          "value": 81.8,
          "unit": "lb"
        },
        {
          "text": "Unsigned reply that reads as the team's: printed parts are almost all PLA or PLA+; a few are Markforged Onyx where it matters, such as the cable-chain support on the telescope",
          "basis": "observer",
          "src": [
            "s4"
          ]
        }
      ]
    },
    {
      "name": "Cable carrier",
      "solves": [
        {
          "text": "Unsigned reply that reads as the team's: carry wires into a sheath and back without a spring",
          "basis": "observer",
          "src": [
            "s6"
          ]
        }
      ],
      "does": [
        "structure"
      ],
      "type": "bent thin polycarbonate strip",
      "serves": [],
      "facts": [
        {
          "text": "Unsigned reply that reads as the team's: a bend down the length makes the strip rigid when straight and flexible once bent",
          "basis": "observer",
          "src": [
            "s6"
          ]
        },
        {
          "text": "Unsigned reply that reads as the team's: no spring pushes it into its sheath, and the bend keeps it from bending the wrong way",
          "basis": "observer",
          "src": [
            "s6"
          ]
        },
        {
          "text": "Unsigned reply that reads as the team's: holes in the strip are only for zip ties, and the method is credited to 971",
          "basis": "observer",
          "src": [
            "s6"
          ]
        }
      ]
    },
    {
      "name": "Bumper mounts",
      "does": [
        "structure"
      ],
      "type": "slide-snap latches",
      "serves": [],
      "facts": [
        {
          "text": "Unsigned reply that reads as the team's: Slide-Snap latches, part 1872A111, with bushings drilled out for #10-32 bolts at the frame and M3 at the bumper",
          "basis": "observer",
          "src": [
            "s4"
          ]
        }
      ]
    }
  ],
  "decisions": [
    {
      "choice": "Pivoting telescoping arm",
      "because": "it was lighter and the team believed it would be faster",
      "instead_of": "a slanted elevator with an extending arm",
      "basis": "team",
      "src": [
        "s11"
      ]
    },
    {
      "choice": "Arm gearbox pivots on a structural cross tube",
      "because": "unsigned replies that read as the team's say the tube was wanted anyway, the chain needs retensioning, and rotation keeps shafts parallel with fewer, simpler parts",
      "instead_of": "a rigid mount or a linear adjuster",
      "basis": "observer",
      "src": [
        "s4"
      ]
    },
    {
      "choice": "Bracing cables on the A-frame",
      "because": "they kept the robot light and fast, a main team goal",
      "basis": "team",
      "src": [
        "s11"
      ]
    },
    {
      "choice": "Most intake effort on cones",
      "because": "the team thought other teams might not pick them up as efficiently",
      "basis": "team",
      "src": [
        "s11"
      ]
    },
    {
      "choice": "A short list of bolt sizes",
      "because": "it is easier for the pit crew, says an unsigned reply that reads as the team's",
      "instead_of": "smaller bolts that would fit the latches",
      "basis": "observer",
      "src": [
        "s4"
      ]
    }
  ],
