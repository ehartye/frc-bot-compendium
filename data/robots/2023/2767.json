  "decisions": [
    {
      "choice": "Elevator",
      "because": "the team had built elevators, including carbon fiber ones, and wanted reliability",
      "cost": "a tall robot over the charge station may be a problem",
      "basis": "team",
      "src": [
        "s11"
      ]
    },
    {
      "choice": "Wide intake for cubes",
      "because": "cubes are soft like the balls its wide intakes handled in 2020 and 2022",
      "basis": "team",
      "src": [
        "s11"
      ]
    },
    {
      "choice": "Wheels in the end effector",
      "because": "they keep turning inward, while a claw that stops lets cones fall out",
      "instead_of": "polycarbonate forks",
      "basis": "team",
      "src": [
        "s11"
      ]
    },
    {
      "choice": "Timing belts at the elbow",
      "because": "they give more surface area of grip",
      "instead_of": "gears, whose teeth kept breaking",
      "basis": "team",
      "src": [
        "s11"
      ]
    },
    {
      "choice": "Bag motor to deploy the intake",
      "because": "high speed was not wanted there",
      "basis": "team",
      "src": [
        "s11"
      ]
    },
    {
      "choice": "Elevator stage on the arm",
      "because": "it kept the tilt of the first axis small and shortened the second axis by a few inches, to minimize the moment arm off the base",
      "basis": "team",
      "src": [
        "s20"
      ]
    },
    {
      "choice": "Move CAD to Onshape",
      "because": "the team wanted its CAD more accessible; several people could work on one subsystem and students started in minutes",
      "cost": "the master sketch was not kept up to date, which caused problems while prototyping",
      "basis": "team",
      "src": [
        "s4",
        "s17"
      ]
    },
    {
      "choice": "Keep subassembly sketches separate in CAD",
      "because": "one person should drive the main assembly, and no one should change something without seeing its impact on it",
      "instead_of": "subassembly sketches derived from the master sketch",
      "basis": "team",
      "src": [
        "s17",
        "s21"
      ]
    }
  ],
