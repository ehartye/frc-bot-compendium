  "story": {
    "bet": [
      {
        "text": "A very reliable robot that scores at a high pace, on an elevator because the team already knew how to build one.",
        "basis": "team",
        "src": [
          "s11"
        ]
      }
    ],
    "demand": [],
    "auto": [
      {
        "text": "At the St. Joseph event the main routine scored a cone, then a cube, then tried to balance. Balancing worked in the shop but less well at the event, and an auto-level using the gyro was in work.",
        "basis": "team",
        "src": [
          "s11"
        ]
      }
    ],
    "cycle": [
      {
        "text": "Cubes go through a wide intake to the end effector. At the substation sensors see the cone and the claw closes by itself.",
        "basis": "team",
        "src": [
          "s11"
        ]
      },
      {
        "text": "Code places pieces automatically using AprilTags.",
        "basis": "team",
        "src": [
          "s4"
        ]
      },
      {
        "text": "All driving is by the driver, with stick limiting during pickup and placing; the drive team starts each automated sequence.",
        "basis": "team",
        "src": [
          "s13"
        ]
      }
    ],
    "endgame": [],
    "fallback": [
      {
        "text": "Manual controls are there if a sequence fails.",
        "basis": "team",
        "src": [
          "s13"
        ]
      }
    ],
    "gave_up": [
      {
        "text": "The team knew a tall robot over the charge station could be a problem and answered with carbon fiber and lighter parts.",
        "basis": "team",
        "src": [
          "s11"
        ]
      },
      {
        "text": "The robot first weighed about 100 lb, and a 20 lb plate was added under the belly pan for stability.",
        "basis": "team",
        "src": [
          "s14"
        ]
      }
    ],
    "changed": [
      {
        "text": "By the St. Joseph event, belts had replaced elbow gears whose teeth kept breaking, and wheels had replaced claw forks.",
        "basis": "team",
        "src": [
          "s11"
        ]
      },
      {
        "text": "Team replies call the interview video out of date and list changes from there to worlds: a larger curved rack, more durable elbow gearboxes, a camera on the elevator for tags in auto, and larger bevel gears in the claw.",
        "basis": "team",
        "src": [
          "s15",
          "s14"
        ]
      }
    ],
    "outcome": [
      {
        "text": "52-14-0 in official play; ranked 15 of the pooled top 20 (OPR 71.39, Daly).",
        "basis": "record",
        "src": [
          "s1",
          "s2"
        ]
      }
    ]
  },
  "functions": [
    {
      "name": "Swerve",
      "solves": [
        {
          "text": "Absorb hard impacts, as when going on and off the charge station",
          "basis": "team",
          "src": [
            "s11"
          ]
        }
      ],
      "does": [
        "drive"
      ],
      "type": "custom swerve, mostly printed Onyx",
      "serves": [],
      "facts": [
        {
          "text": "Mostly printed Onyx",
          "basis": "team",
          "src": [
            "s4"
          ]
        },
        {
          "text": "Lighter than the team's earlier modules",
          "basis": "team",
          "src": [
            "s11"
          ]
        },
        {
          "text": "No suspension in the module; the aluminium frame it bolts to takes hard impacts",
          "basis": "team",
          "src": [
            "s11"
          ]
        }
      ]
    },
    {
      "name": "Frame",
      "does": [
        "structure"
      ],
      "type": "chromoly steel frame",
      "serves": [],
      "facts": [
        {
          "text": "The CAD release lists a chromoly steel frame; the earlier interview speaks of an aluminium frame under the swerve modules",
          "basis": "team",
          "src": [
            "s4",
            "s11"
          ]
        },
        {
          "text": "The team says the chassis it made parametric for 2024 is unchanged from the one it ran in 2023",
          "basis": "team",
          "src": [
            "s8"
          ]
        }
      ]
    },
    {
      "name": "Cube intake",
      "pieces": [
        "cube"
      ],
      "solves": [
        {
          "text": "Pick up soft cubes across a wide area",
          "basis": "team",
          "src": [
            "s11"
          ]
        }
      ],
      "does": [
        "acquire"
      ],
      "type": "wide deployed intake with belts, cubes only",
      "serves": [
        "grid-low",
        "grid-mid",
        "grid-high"
      ],
      "facts": [
        {
          "text": "Belts run over printed pieces on an aluminium bar",
          "basis": "team",
          "src": [
            "s11"
          ]
        },
        {
          "text": "A bag motor deploys it and a Falcon drives the belts",
          "basis": "team",
          "src": [
            "s11"
          ]
        },
        {
          "text": "Space was left for a cube to leave the robot instead of getting trapped",
          "basis": "team",
          "src": [
            "s11"
          ]
        }
      ]
    },
    {
      "name": "End effector",
      "pieces": [
        "cone",
        "cube"
      ],
      "solves": [
        {
          "text": "Hold a cone so it does not fall out",
          "basis": "team",
          "src": [
            "s11"
          ]
        }
      ],
      "does": [
        "acquire",
        "retain",
        "deliver"
      ],
      "type": "claw with powered wheels",
      "serves": [
        "grid-low",
        "grid-mid",
        "grid-high"
      ],
      "facts": [
        {
          "text": "Wheels can keep rotating inward to hold the piece",
          "basis": "team",
          "src": [
            "s11"
          ]
        },
        {
          "text": "Sensors see a cone at the substation and close the claw automatically",
          "basis": "team",
          "src": [
            "s11"
          ]
        },
        {
          "text": "The team experimented with printed bevel gears in it",
          "basis": "team",
          "src": [
            "s8"
          ]
        },
        {
          "text": "Larger bevel gears by worlds",
          "basis": "team",
          "src": [
            "s14"
          ]
        }
      ]
    },
    {
      "name": "Elevator",
      "solves": [
        {
          "text": "Score reliably at a high pace with a design the team was comfortable building",
          "basis": "team",
          "src": [
            "s11"
          ]
        }
      ],
      "does": [
        "position"
      ],
      "type": "carbon fiber single-stage elevator",
      "serves": [
        "grid-low",
        "grid-mid",
        "grid-high"
      ],
      "facts": [
        {
          "text": "A printed Onyx gearbox on the carriage moves the arm",
          "basis": "team",
          "src": [
            "s4"
          ]
        },
        {
          "text": "Set points, about half of them for sequences",
          "basis": "team",
          "src": [
            "s13"
          ],
          "value": 24,
          "unit": "set points"
        },
        {
          "text": "Carbon fiber comes from Rock West Composites; most printed parts are Onyx, some PETG",
          "basis": "team",
          "src": [
            "s16"
          ]
        },
        {
          "text": "Unlike the elevator's elbow joints, some carbon tube joints were assembled dry, then hot glue was shot through holes into grooves inside",
          "basis": "team",
          "src": [
            "s14"
          ]
        }
      ],
      "cost": [
        {
          "text": "A tall robot over the charge station may be a problem",
          "basis": "team",
          "src": [
            "s11"
          ]
        }
      ]
    },
    {
      "name": "Sector gear",
      "solves": [
        {
          "text": "Bring the piece closer to the second and third levels without relying only on the arm",
          "basis": "team",
          "src": [
            "s11"
          ]
        }
      ],
      "does": [
        "position"
      ],
      "type": "printed sector gears that pivot the elevator",
      "serves": [
        "grid-mid",
        "grid-high"
      ],
      "facts": [
        {
          "text": "Printed Onyx laid with Kevlar and carbon fiber",
          "basis": "team",
          "src": [
            "s11"
          ]
        },
        {
          "text": "Clamped and glued onto carbon fiber",
          "basis": "team",
          "src": [
            "s11"
          ]
        },
        {
          "text": "The curved rack was larger and taller by worlds",
          "basis": "team",
          "src": [
            "s14"
          ]
        },
        {
          "text": "Printed gear profiles came from Onshape feature scripts; occasionally extra backlash was needed for smooth running",
