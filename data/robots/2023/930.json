  "story": {
    "auto": [
      {
        "text": "The team lists five or more auto paths and auto balance. One path picks up cubes from the ground while driving backwards, using arm positions kept for auto.",
        "basis": "team",
        "src": [
          "s4",
          "s5"
        ]
      },
      {
        "text": "A post by 111, which picked it at Midwest, cites fantastic autonomous routines and extremely consistent performance.",
        "basis": "observer",
        "src": [
          "s9"
        ]
      }
    ],
    "cycle": [
      {
        "text": "Arm, intake and elevator go to preset positions. The substation preset reaches one way and the arm also goes backwards; in teleop the team prefers to pick up in front. The drop-off preset angles the cone over the pole.",
        "basis": "team",
        "src": [
          "s5"
        ]
      }
    ],
    "changed": [
      {
        "text": "Several manipulators: the earlier one struggled as cubes bounced off it, so the team refitted an idea from WildStang's Open Alliance work. The aluminum arm became carbon fiber.",
        "basis": "team",
        "src": [
          "s5"
        ]
      },
      {
        "text": "A cube floor intake, for low scoring only, was added by the Wisconsin Regional but not yet used in a match; the team page later lists a ground cube intake.",
        "basis": "team",
        "src": [
          "s5",
          "s4"
        ]
      }
    ],
    "outcome": [
      {
        "text": "47-13-1 in official play; ranked 21 by championship OPR (69.74, Milstein).",
        "basis": "record",
        "src": [
          "s1",
          "s2"
        ]
      }
    ]
  },
  "functions": [
    {
      "name": "Drivetrain",
      "does": [
        "drive",
        "structure"
      ],
      "type": "four-wheel swerve",
      "serves": [],
      "facts": [
        {
          "text": "Four-wheel swerve",
          "basis": "team",
          "src": [
            "s4"
          ]
        },
        {
          "text": "The page lists a steel belly pan and 2x1",
          "basis": "team",
          "src": [
            "s4"
          ]
        }
      ]
    },
    {
      "name": "Elevator",
      "solves": [
        {
          "text": "Raise the arm with a low center of gravity and let it pass front to back",
          "basis": "team",
          "src": [
            "s5"
          ]
        }
      ],
      "does": [
        "position"
      ],
      "type": "45 degree continuous elevator",
      "pieces": [
        "cone",
        "cube"
      ],
      "serves": [
        "grid-low",
        "grid-mid",
        "grid-high"
      ],
      "facts": [
        {
          "text": "Continuous rigging: the carriage rises to the top of the first stage before the rest moves",
          "basis": "team",
          "src": [
            "s5"
          ]
        },
        {
          "text": "First stage uses two aluminum tubes bolted together rather than one",
          "basis": "team",
          "src": [
            "s7"
          ]
        },
        {
          "text": "The belt runs inside the tubing for packaging and protection",
          "basis": "team",
          "src": [
            "s7"
          ]
        },
        {
          "text": "Two NEOs drive it, with the gearing low",
          "basis": "team",
          "src": [
            "s5"
          ]
        },
        {
          "text": "No bars connect the stages, so the arm passes through front to back; plates on the bearing blocks keep them together",
          "basis": "team",
          "src": [
            "s5"
          ]
        }
      ],
      "cost": [
        {
          "text": "A belt came loose in a Wisconsin playoff match the alliance lost 127-133",
          "basis": "team",
          "src": [
            "s8"
          ]
        }
      ]
    },
    {
      "name": "Arm and wrist drive",
      "solves": [
        {
          "text": "Keep the arm light so the robot does not tip when reaching or intaking",
          "basis": "team",
          "src": [
            "s5"
          ]
        }
      ],
      "does": [
        "position"
      ],
      "type": "carbon fiber arm and wrist on one dead axle",
      "pieces": [
        "cone",
        "cube"
      ],
      "serves": [
        "grid-mid",
        "grid-high"
      ],
      "facts": [
        {
          "text": "Two separate spline pieces on a dead axle move arm and wrist independently while lined up",
          "basis": "team",
          "src": [
            "s5"
          ]
        },
        {
          "text": "The carbon fiber arm is interchangeable",
          "basis": "team",
          "src": [
            "s4"
          ]
        }
      ]
    },
    {
      "name": "Belt manipulator",
      "solves": [
        {
          "text": "Pick up cubes that bounced off the earlier manipulator, and grip cones",
          "basis": "team",
          "src": [
            "s5"
          ]
        }
      ],
      "does": [
        "acquire",
        "retain",
        "deliver"
      ],
      "type": "V-shaped polyurethane belt intake",
      "pieces": [
        "cone",
        "cube"
      ],
      "serves": [
        "grid-low",
        "grid-mid",
        "grid-high"
      ],
      "facts": [
        {
          "text": "The team page calls it a V-shaped polybelt intake",
          "basis": "team",
          "src": [
            "s4"
          ]
        },
        {
          "text": "Polyurethane belts grip the cone well",
          "basis": "team",
          "src": [
            "s5"
          ]
        },
        {
          "text": "It takes pieces from a vertical position rather than horizontal, which made cubes much easier to grab",
          "basis": "team",
          "src": [
            "s5"
          ]
        },
        {
          "text": "It can hold a cone under heavy defense",
          "basis": "team",
          "src": [
            "s5"
          ]
        },
        {
          "text": "Spacers on the ends keep the running belts from burning holes in the carpet",
          "basis": "team",
          "src": [
            "s5"
          ]
        }
      ]
    },
    {
      "name": "Ground cube intake",
      "solves": [
        {
          "text": "Take cubes from the ground and score them low quickly to complete links",
          "basis": "team",
          "src": [
            "s5"
          ]
        }
      ],
      "does": [
        "acquire",
        "deliver"
      ],
      "type": "motor-extended wheeled intake for cubes",
      "pieces": [
        "cube"
      ],
      "serves": [
        "grid-low",
        "link"
      ],
      "facts": [
        {
          "text": "A motor extends it and wheels bring the cube in; it scores low only",
          "basis": "team",
          "src": [
            "s5"
          ]
        },
        {
          "text": "Planned for matches expected to be won, to make links for the ranking point",
          "basis": "team",
          "src": [
            "s5"
          ]
        }
      ],
      "cost": [
        {
          "text": "At the Wisconsin Regional it had not yet been used on the field",
          "basis": "team",
          "src": [
            "s5"
          ]
        }
      ]
    },
    {
      "name": "Position presets",
      "solves": [
        {
          "text": "Put elevator, arm and manipulator at a known position for each task",
          "basis": "team",
          "src": [
            "s5"
          ]
        }
      ],
      "does": [
        "sense",
        "position"
      ],
      "type": "encoder-based position presets",
      "pieces": [
        "cone",
        "cube"
      ],
      "serves": [],
      "facts": [
        {
          "text": "Encoders on arm, manipulator and elevator hold stored angles and heights",
          "basis": "team",
          "src": [
            "s5"
          ]
        },
        {
          "text": "A few positions are used only in autonomous",
          "basis": "team",
          "src": [
            "s5"
          ]
        },
        {
          "text": "Presets for picking up from the substation, for drop-off and for reaching backwards",
          "basis": "team",
          "src": [
            "s5"
          ]
        }
      ]
    }
  ],
  "decisions": [
    {
      "choice": "A carbon fiber arm",
      "because": "it is lighter, so the robot does not tip when going up to score or down to intake",
      "instead_of": "the earlier aluminum arm",
      "basis": "team",
      "src": [
        "s5"
      ]
    },
    {
      "choice": "A continuous elevator",
      "because": "a cascade would raise part of the elevator early and waste center of gravity",
      "instead_of": "a cascading elevator, used in 2018",
      "basis": "team",
      "src": [
        "s5"
      ]
    },
    {
      "choice": "Run the elevator belt inside the tubing",
      "because": "packaging is easier and the belt is protected",
      "basis": "team",
      "src": [
        "s7"
      ]
    },
    {
      "choice": "Refit WildStang's manipulator idea",
      "because": "the earlier one struggled with cubes bouncing off",
      "instead_of": "a very common-looking manipulator of its own",
      "basis": "team",
      "src": [
        "s5"
      ]
    }
  ],
