  "story": {
    "demand": [
      {
        "text": "The team says it focuses mainly on cones and is fast. For alliance selection at its second event it mainly wanted a cube robot, so it could fill the top of the grid with cones while the partner placed cubes.",
        "basis": "team",
        "src": [
          "s6"
        ]
      }
    ],
    "auto": [
      {
        "text": "The arm can start all the way back, clipped by a magnet. The team says this saves about a second of auto.",
        "basis": "team",
        "src": [
          "s6"
        ]
      }
    ],
    "cycle": [
      {
        "text": "In one high-scoring match it filled its own area of the grid, three high, three mid and three low, then helped its partners by filling low nodes.",
        "basis": "team",
        "src": [
          "s6"
        ]
      },
      {
        "text": "A list of full-grid matches names this robot in two, both at the district championship.",
        "basis": "observer",
        "src": [
          "s9"
        ]
      }
    ],
    "changed": [
      {
        "text": "The intake is the fifth version. The first design used wheels meant to drop the cone straight down, and it did not work out. The hand was first angled, then made flat so it could lie on the ground and pick up a tipped cone.",
        "basis": "team",
        "src": [
          "s6"
        ]
      }
    ],
    "outcome": [
      {
        "text": "48-16-0 in official play; ranked 11 of the pooled top 20 (OPR 75.02, Daly).",
        "basis": "record",
        "src": [
          "s1",
          "s2"
        ]
      }
    ]
  },
  "functions": [
    {
      "name": "Arm",
      "pieces": [
        "cone"
      ],
      "does": [
        "position"
      ],
      "type": "carbon fiber arm, each arm moving independently",
      "serves": [
        "grid-low",
        "grid-mid",
        "grid-high"
      ],
      "facts": [
        {
          "text": "Inspired by 971's 2018 robot; the team says the carbon fiber is about half the weight of aluminum and four times as strong",
          "basis": "team",
          "src": [
            "s6"
          ]
        },
        {
          "text": "A custom gearbox controls the arm at about 90 to 1",
          "basis": "team",
          "src": [
            "s6"
          ]
        },
        {
          "text": "Dyneema line runs on its pulleys; the team pre-stretched it by tightening a turnbuckle between rounds of practice driving",
          "basis": "team",
          "src": [
            "s7",
            "s8"
          ]
        }
      ]
    },
    {
      "name": "Arm point recording",
      "solves": [
        {
          "text": "Control the movements of arms that move independently",
          "basis": "team",
          "src": [
            "s6"
          ]
        }
      ],
      "does": [
        "sense",
        "position"
      ],
      "type": "taught positions",
      "serves": [],
      "facts": [
        {
          "text": "Someone moves the arm by hand and the robot records the points to repeat later",
          "basis": "team",
          "src": [
            "s6"
          ]
        }
      ]
    },
    {
      "name": "Intake",
      "pieces": [
        "cone"
      ],
      "solves": [
        {
          "text": "Pick up a tipped cone from the floor",
          "basis": "team",
          "src": [
            "s6"
          ]
        }
      ],
      "does": [
        "acquire",
        "retain"
      ],
      "type": "motorized roller hand",
      "serves": [
        "grid-low",
        "grid-mid",
        "grid-high"
      ],
      "facts": [
        {
          "text": "A NEO 550 drives the rollers; spinning one way takes cones with a plain roller and 2 in wheels",
          "basis": "team",
          "src": [
            "s6"
          ]
        },
        {
          "text": "A pulley drives a further roller",
          "basis": "team",
          "src": [
            "s6"
          ]
        },
        {
          "text": "It squeezes a cone tightly",
          "basis": "team",
          "src": [
            "s6"
          ]
        }
      ],
      "cost": [
        {
          "text": "It took five versions",
          "basis": "team",
