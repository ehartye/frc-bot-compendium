  "decisions": [
    {
      "choice": "Double-jointed arm",
      "because": "its range of motion lets the team iterate in software with little mechanical change",
      "instead_of": "a tilted elevator",
      "basis": "team",
      "src": [
        "s11"
      ]
    },
    {
      "choice": "Pass the arm through the robot",
      "because": "swinging over would flip the robot, even with the ballast added",
      "instead_of": "passing over the top",
      "basis": "team",
      "src": [
        "s11"
      ]
    },
    {
      "choice": "Drive each joint from one side",
      "because": "it saves weight and complexity",
      "instead_of": "driving from both sides",
      "cost": "twice the load on the chain",
      "basis": "team",
      "src": [
        "s11"
      ]
    },
    {
      "choice": "Full-width cube intake and no floor cones",
      "because": "floor cones would take too much driver alignment, especially under defense",
      "instead_of": "a floor cone intake",
      "basis": "team",
      "src": [
        "s11"
      ]
    },
    {
      "choice": "Put placing in software",
      "because": "software can be consistent when a driver cannot",
      "basis": "team",
      "src": [
        "s11"
      ]
    },
    {
      "choice": "Optimised arm trajectories",
      "because": "the team wanted placing faster than linear mechanisms",
      "instead_of": "simple PID and motion profiles",
      "basis": "team",
      "src": [
        "s12"
      ]
    },
    {
      "choice": "Plain P and D gains for alignment",
      "because": "something simpler can work better; it placed consistently faster than any human",
      "instead_of": "trajectory generation or profiling",
      "basis": "team",
      "src": [
        "s12"
      ]
    },
    {
      "choice": "Optimize arm paths before camera frame rate",
      "because": "going from 25 to 50 frames a second probably would not have given a measurable benefit",
      "basis": "team",
      "src": [
        "s12"
      ]
    },
    {
      "choice": "Reach a working robot on simple PID first",
      "because": "a new feature should not risk the robot lacking complete code, and must give a real competitive advantage",
      "instead_of": "starting with optimized trajectories",
      "basis": "team",
      "src": [
        "s12"
      ]
    }
  ],
