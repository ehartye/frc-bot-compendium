  "story": {
    "bet": [
      {
        "text": "A double-jointed arm, run at its mechanical limits to match the speed of an elevator, with some of the iteration moved into software.",
        "basis": "team",
        "src": [
          "s11"
        ]
      }
    ],
    "demand": [
      {
        "text": "Place on all three levels, and reach every set point from pickup in under a second. Cones came from the double substation because floor cones would take too much driver alignment, especially with midfield defense.",
        "basis": "team",
        "src": [
          "s11"
        ]
      }
    ],
    "auto": [],
    "cycle": [
      {
        "text": "Load at the double substation. The operator picks one of 27 grid buttons and the driver confirms. Two cameras align the robot to AprilTags; it drives over, swings the arm up and then down, places, retracts clear of the nodes and drives out.",
        "basis": "team",
        "src": [
          "s11"
        ]
      }
    ],
    "endgame": [],
    "fallback": [],
    "gave_up": [
      {
        "text": "No cone pickup from the floor. Driving each joint from one side doubles the load on its chain, a risk the team took to save weight and complexity.",
        "basis": "team",
        "src": [
          "s11"
        ]
      }
    ],
    "changed": [
      {
        "text": "The cube intake was added after a few competitions. Its flaps let cubes run into the robot or spin out, and a rigid shaft popped them; a truck strap wrapped in duct tape worked.",
        "basis": "team",
        "src": [
          "s11"
        ]
      },
      {
        "text": "The arm first ran on PID and motion profiles, later on optimised trajectories.",
        "basis": "team",
        "src": [
          "s12"
        ]
      },
      {
        "text": "Cameras moved to the back after the first two competitions for a better view.",
        "basis": "team",
        "src": [
          "s13"
        ]
      }
    ],
    "outcome": [
      {
        "text": "49-18-1 in official play; ranked 2 of the pooled top 20 (OPR 81.60, Archimedes).",
        "basis": "record",
        "src": [
          "s1",
          "s2"
        ]
      }
    ]
  },
  "functions": [
    {
      "name": "Swerve",
      "does": [
        "drive"
      ],
      "type": "swerve",
      "serves": [],
      "facts": [
        {
          "text": "Swerve modules",
          "basis": "team",
