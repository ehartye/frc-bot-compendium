          ],
          "value": 4,
          "unit": "modules"
        }
      ]
    },
    {
      "name": "Double-jointed arm",
      "pieces": [
        "cone",
        "cube"
      ],
      "solves": [
        {
          "text": "Place on all three levels as fast as an elevator without tipping the robot",
          "basis": "team",
          "src": [
            "s11"
          ]
        }
      ],
      "does": [
        "position"
      ],
      "type": "pass-through double-jointed arm",
      "serves": [
        "grid-low",
        "grid-mid",
        "grid-high"
      ],
      "facts": [
        {
          "text": "Both joints are driven from one gearbox, which takes weight off the first joint",
          "basis": "team",
          "src": [
            "s11"
          ]
        },
        {
          "text": "The roller gearbox sits across the pivot and counterbalances the second joint",
          "basis": "team",
          "src": [
            "s11"
          ]
        },
        {
          "text": "Each joint is driven from one side only",
          "basis": "team",
          "src": [
            "s11"
          ]
        },
        {
          "text": "Goal for reaching any set point from pickup, under",
          "basis": "team",
          "src": [
            "s11"
          ],
          "value": 1,
          "unit": "s"
        },
        {
          "text": "The outermost wheels extend to just under the rule's limit",
          "basis": "team",
          "src": [
            "s14",
            "s15"
          ]
        }
      ],
      "cost": [
        {
          "text": "Twice the load on each chain as driving from both sides",
          "basis": "team",
          "src": [
            "s11"
          ]
        },
        {
          "text": "The cantilevered chain tensioner likely wore the idler standoffs, though not enough to replace them; an off-season redesign used bulkier, stronger tensioners inspired by 33",
          "basis": "team",
          "src": [
            "s16"
          ]
        }
      ]
    },
    {
      "name": "Rollers",
      "pieces": [
        "cone",
        "cube"
      ],
      "solves": [
        {
          "text": "Grip cones securely",
          "basis": "team",
          "src": [
            "s11"
          ]
        }
      ],
      "does": [
        "acquire",
        "retain",
        "deliver"
      ],
      "type": "high-ratio rollers on the arm",
      "serves": [
        "grid-low",
        "grid-mid",
        "grid-high"
      ],
      "facts": [
        {
          "text": "A high gear ratio lets them grip cones without dropping them",
          "basis": "team",
          "src": [
            "s11"
          ]
        }
      ],
      "cost": [
        {
          "text": "Dead weight from the motors and gears, placed to balance the arm",
          "basis": "team",
          "src": [
            "s11"
          ]
        }
      ]
    },
    {
      "name": "Cube intake",
      "pieces": [
        "cube"
      ],
      "solves": [
        {
          "text": "Pick up cubes with little driver alignment",
          "basis": "team",
          "src": [
            "s11"
          ]
        }
      ],
      "does": [
        "acquire",
        "transfer"
      ],
      "type": "full-width floor intake with flaps, cubes only",
      "serves": [
        "grid-low",
        "grid-mid",
        "grid-high"
      ],
      "facts": [
        {
          "text": "Polycarbonate flaps bring the cube to the middle",
          "basis": "team",
          "src": [
            "s11"
          ]
        },
        {
          "text": "A truck strap wrapped in duct tape guides the cube; the tape adds grip and resists twisting",
          "basis": "team",
          "src": [
            "s11"
          ]
        },
        {
          "text": "Its chain tensioner is simply cantilevered, which worked because chain loads were low; the team would consider an inline tensioner in future",
          "basis": "team",
          "src": [
            "s16"
          ]
        }
      ],
      "cost": [
        {
          "text": "Flaps alone let cubes run into the robot or spin out the back",
          "basis": "team",
          "src": [
            "s11"
          ]
        }
      ]
    },
    {
      "name": "Automatic placement",
      "pieces": [
        "cone",
        "cube"
      ],
      "solves": [
        {
          "text": "Take alignment out of the driver's hands",
          "basis": "team",
          "src": [
            "s11"
          ]
        }
      ],
      "does": [
        "sense",
        "position"
      ],
      "type": "camera-aligned driving and placing",
      "serves": [
        "grid-low",
        "grid-mid",
        "grid-high"
      ],
      "facts": [
        {
          "text": "Two cameras with AprilTags",
          "basis": "team",
          "src": [
            "s11"
          ]
        },
        {
          "text": "Operator buttons cover the whole grid",
          "basis": "team",
          "src": [
            "s11"
          ],
          "value": 27,
          "unit": "buttons"
        },
        {
          "text": "Alignment was only a P and a D gain, and the software captain says it placed consistently faster than any human",
          "basis": "team",
          "src": [
            "s12"
          ]
        },
        {
          "text": "Position estimate when placing was within about",
          "basis": "team",
          "src": [
            "s17"
          ],
          "value": 0.5,
          "unit": "in"
        },
        {
          "text": "Odometry runs on a separate software loop",
          "basis": "team",
          "src": [
            "s12"
          ]
        },
        {
          "text": "The team says it uses PathPlanner",
          "basis": "team",
          "src": [
            "s18"
          ]
        }
      ]
    },
    {
      "name": "Arm trajectories",
      "solves": [
        {
          "text": "Make placing faster than linear mechanisms such as elevators",
          "basis": "team",
          "src": [
            "s12"
          ]
        }
      ],
      "does": [
        "sense"
      ],
      "type": "numerically optimised arm paths",
      "serves": [
        "grid-low",
        "grid-mid",
        "grid-high"
      ],
      "facts": [
        {
          "text": "Trajectories come from numerical optimisation solvers",
          "basis": "team",
          "src": [
            "s12"
          ]
        },
        {
          "text": "Code for the double-jointed arm was ready in week 2 or 3, using simple simulation",
          "basis": "team",
          "src": [
            "s12"
          ]
        },
        {
          "text": "Built with CasADi in Python from the arm's Lagrangian dynamics and DC motor equations; the software captain says it was very similar to 6328's method, with extra handling for motions such as placing down",
          "basis": "team",
          "src": [
            "s19"
          ]
        },
        {
          "text": "The software captain says it made a cycle \"2-3 seconds fast\", with 10 or more cycles every match",
          "basis": "team",
          "src": [
            "s12"
          ]
        }
      ]
    },
