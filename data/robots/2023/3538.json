  "story": {
    "outcome": [
      {
        "text": "65-20-1 in official play; ranked 12 of the pooled top 20 (OPR 74.90, Newton).",
        "basis": "record",
        "src": [
          "s1",
          "s2"
        ]
      }
    ],
    "bet": [
      {
        "text": "Get the fastest cycle times possible, with less aiming for the drive team.",
        "basis": "team",
        "src": [
          "s10"
        ]
      }
    ],
    "auto": [
      {
        "text": "The bump auto scores the preloaded cone, takes and scores a cube, then picks up another cone, on paths optimized from waypoints. On the charge station, drive speed is proportional to gyro pitch, so the robot slows as it balances.",
        "basis": "team",
        "src": [
          "s10"
        ]
      }
    ],
    "cycle": [
      {
        "text": "The interviewer says pieces come mostly from the human player.",
        "basis": "observer",
        "src": [
          "s10"
        ]
      },
      {
        "text": "The intake keeps turning slowly in its last direction, so it takes a piece with no operator input. Mid and high use the same arm angle; the slide extends for high.",
        "basis": "team",
        "src": [
          "s10"
        ]
      }
    ],
    "gave_up": [
      {
        "text": "Quick ground pickup. It works, but takes longer to line up, so it is used in autonomous and early in the match for pieces left on the floor.",
        "basis": "team",
        "src": [
          "s10"
        ]
      }
    ],
    "changed": [
      {
        "text": "A first-week intake took cones and cubes well but had trouble scoring them, so the intake was curved. Mid-season the team adopted a path program for its advanced autos. Elbow presets that were five or six degrees off now land within one or two.",
        "basis": "team",
        "src": [
          "s10"
        ]
      }
    ]
  },
  "functions": [
    {
      "name": "Swerve on custom Colson wheels",
      "solves": [
        {
          "text": "Get the traction the team liked on tank drives, and get onto the charge station more easily",
          "basis": "team",
          "src": [
            "s10"
          ]
        }
      ],
      "does": [
        "drive"
      ],
      "type": "swerve with custom wheels",
      "serves": [
        "charge-station"
      ],
      "facts": [
        {
          "text": "Colson wheels fitted to the team's swerve modules, in use since the start of the season",
          "basis": "team",
          "src": [
            "s10"
          ]
        }
      ]
    },
    {
      "name": "Virtual four-bar arm",
      "pieces": [
        "cone",
        "cube"
      ],
      "solves": [
        {
          "text": "Score mid and high at the same angle just by extending the slide",
          "basis": "team",
          "src": [
            "s10"
          ]
        }
      ],
      "does": [
        "position"
      ],
      "type": "virtual four-bar arm with a slide",
      "serves": [
        "grid-mid",
        "grid-high"
      ],
      "facts": [
        {
          "text": "Range, about",
          "basis": "team",
          "src": [
            "s10"
          ],
          "value": 360,
          "unit": "deg"
        },
        {
          "text": "Sprockets at chosen angles let it reach the scoring positions, the human player station and the ground",
          "basis": "team",
          "src": [
            "s10"
          ]
        },
        {
          "text": "Positions shown are stow, mid, high, transit and ground",
          "basis": "team",
          "src": [
            "s10"
          ]
        }
      ]
    },
    {
      "name": "Intake",
      "pieces": [
        "cone",
        "cube"
      ],
      "solves": [
        {
          "text": "Less aiming, for faster cycles",
          "basis": "team",
          "src": [
            "s10"
          ]
        }
      ],
      "does": [
        "acquire",
        "retain",
        "deliver"
      ],
      "type": "large curved wheeled intake",
      "serves": [
        "grid-mid",
        "grid-high"
      ],
      "facts": [
        {
          "text": "It idles at low speed in its last direction; a popped cube is taken back in by itself",
          "basis": "team",
          "src": [
            "s10"
          ]
        },
        {
          "text": "The curve lets it pick up cones and score them at an easier angle",
          "basis": "team",
          "src": [
            "s10"
          ]
        }
      ],
      "cost": [
        {
          "text": "Ground pickup takes longer to line up",
          "basis": "team",
          "src": [
            "s10"
          ]
        }
      ]
    },
    {
      "name": "Auto balance",
      "does": [
        "sense"
      ],
      "type": "proportional control on gyro pitch",
      "serves": [
        "charge-station"
      ],
      "facts": [
        {
          "text": "Drive speed is pitch times a constant, so it falls as the robot levels",
          "basis": "team",
          "src": [
            "s10"
          ]
        }
      ]
    },
    {
      "name": "Elbow control",
      "solves": [
        {
