  "story": {
    "bet": [
      {
        "text": "Two intakes instead of a turret: take notes from front or back for fast cleanup cycles on a simpler robot.",
        "basis": "team",
        "src": [
          "s12"
        ]
      }
    ],
    "demand": [],
    "auto": [
      {
        "text": "About 20 autos with different note orders, made at championships to beat other teams to the center line. Note detection proved too slow in auto, so odometry takes over after the wing line.",
        "basis": "team",
        "src": [
          "s12"
        ]
      }
    ],
    "cycle": [
      {
        "text": "A note enters from front or back and stages in the shooter. The team then chooses on the fly: shoot it at the speaker, or feed it back a little and pop it up into the carriage on the elevator for the amp. The team says it can do all four notes of an amplified period in about 5 seconds.",
        "basis": "team",
        "src": [
          "s12"
        ]
      }
    ],
    "endgame": [
      {
        "text": "Climb, raise the elevator over the trap's ledge, then spin the note out.",
        "basis": "team",
        "src": [
          "s12"
        ]
      },
      {
        "text": "The trap was very manual: after the climb, holding a button sent the elevator to full height.",
        "basis": "team",
        "src": [
          "s13"
        ]
      }
    ],
    "fallback": [
      {
        "text": "When a defender blocks the AprilTags, aiming continues from odometry.",
        "basis": "team",
        "src": [
          "s12"
        ]
      }
    ],
    "gave_up": [
      {
        "text": "No turret. The team said one would add a lot of complexity and make the handoff and intake harder; it judged its robot not quite the same as another team's turret but pretty close, and much simpler.",
        "basis": "team",
        "src": [
          "s12"
        ]
      }
    ],
    "changed": [
      {
        "text": "At earlier events notes without spin dove and flipped on long shots, so the shooter became differential.",
        "basis": "team",
        "src": [
          "s12"
        ]
      },
      {
        "text": "The hood rack skipped teeth and got a higher DP and a steel shaft in mid-season; the elevator mechanism was not on the robot until the Friday before the Central Missouri Regional.",
        "basis": "team",
        "src": [
          "s14",
          "s15"
        ]
      }
    ],
    "outcome": [
      {
        "text": "44-4-0 in official play; ranked 11 of the pooled top 20 (OPR 55.09, Johnson).",
        "basis": "record",
        "src": [
          "s1",
          "s2"
        ]
      }
    ]
  },
  "functions": [
    {
      "name": "Swerve drive",
      "does": [
        "drive"
      ],
      "type": "beltless swerve (Thrifty beta)",
      "serves": [],
      "facts": [
        {
          "text": "The interviewer calls the team one of the beta testers of the Thrifty swerve",
          "basis": "observer",
          "src": [
            "s12"
          ]
        },
        {
          "text": "It runs a middle gearing for an even balance of torque and speed",
          "basis": "team",
          "src": [
            "s12"
          ]
        },
        {
          "text": "It likes the beltless layout, the grip of its wheels of about an inch and a half, and gears with steel outside and aluminum inside to save weight",
          "basis": "team",
          "src": [
            "s12"
          ]
        }
      ]
    },
    {
      "name": "Front and back intakes",
      "pieces": [
        "note"
      ],
      "solves": [
        {
          "text": "Pick up from both sides for smooth cleanup cycles without a turret",
          "basis": "team",
          "src": [
            "s12"
          ]
        }
      ],
      "does": [
        "acquire"
      ],
      "type": "two roller intakes",
      "serves": [
        "speaker",
        "amp",
        "trap"
      ],
      "facts": [
        {
          "text": "Notes come in from the front or the back",
          "basis": "team",
          "src": [
            "s12"
          ]
        },
        {
          "text": "The front has an extra roller so a note against a wall does not stay under the robot",
          "basis": "team",
          "src": [
            "s12"
          ]
        }
      ],
      "cost": [
        {
          "text": "The front roller came a couple of weeks later and took a while to perfect because it added a lot of tension",
          "basis": "team",
          "src": [
            "s12"
          ]
        }
      ]
    },
    {
      "name": "Differential shooter",
      "pieces": [
        "note"
      ],
      "solves": [
        {
          "text": "Spin the note so it does not dive or flip on long shots",
          "basis": "team",
          "src": [
            "s12"
          ]
        }
      ],
      "does": [
        "deliver"
      ],
      "type": "two-speed side-to-side wheel shooter",
      "serves": [
        "speaker"
      ],
      "facts": [
        {
          "text": "One side powers the axle all the way across; a Kraken under the shooter spins the other side at another rate on that same axle",
          "basis": "team",
          "src": [
            "s12"
          ]
        }
      ]
    },
    {
      "name": "Shooter hood",
      "pieces": [
        "note"
      ],
      "does": [
        "position"
      ],
      "type": "rack-and-pinion hood",
      "serves": [
        "speaker"
      ],
      "facts": [
        {
          "text": "The hood used only a P gain, though it should also have arm feedforward because its center of gravity swings",
          "basis": "team",
          "src": [
            "s16"
          ]
        },
        {
          "text": "The team would redesign it so the pinion moves with the shooter",
          "basis": "team",
          "src": [
            "s15"
          ]
        }
      ],
      "cost": [
        {
          "text": "The rack skipped teeth; the team raised the DP and used a drop-in steel shaft with 3x the stiffness",
          "basis": "team",
          "src": [
            "s15"
          ]
        }
      ]
    },
    {
      "name": "Handoff",
      "pieces": [
        "note"
      ],
      "solves": [
        {
          "text": "Decide on the fly between the speaker and the amp with one intake path",
          "basis": "team",
          "src": [
            "s12"
          ]
        }
      ],
      "does": [
        "transfer"
      ],
      "type": "shooter-to-carriage roller handoff",
      "serves": [
        "amp",
        "trap"
      ],
      "facts": [
        {
          "text": "The note stages in the shooter; then rollers feed it back a little and up so it flops into the orange roller in the carriage",
          "basis": "team",
          "src": [
            "s12"
          ]
        }
      ]
    },
    {
      "name": "Elevator and carriage",
      "pieces": [
        "note"
      ],
      "solves": [
        {
          "text": "Score amp and trap from one fairly compact mechanism",
          "basis": "team",
          "src": [
            "s12"
          ]
        }
      ],
      "does": [
        "position",
        "deliver"
      ],
      "type": "belt-driven elevator with roller carriage",
      "serves": [
        "amp",
        "trap"
      ],
      "facts": [
        {
          "text": "A gearbox below drives a belt up through the tubes over custom blocks, with a tensioner on each side of the carriage; the design drew on High Tide's previous robot",
          "basis": "team",
          "src": [
            "s12"
          ]
        },
        {
          "text": "The carriage is clamped to the belt and rises first, then each stage is pushed up; the motor stalls at full height, which is used for the trap",
          "basis": "team",
          "src": [
            "s17"
          ]
        },
        {
          "text": "The two sides were not linked, so belt turnbuckles and free rolling needed fine tuning or the elevator would rack or skip teeth; ideally the team would have done this differently",
          "basis": "team",
          "src": [
            "s14"
          ]
        },
        {
          "text": "Motion uses WPILib elevator feedforward and a trapezoidal profile, not Smart Motion; with a Kraken the team would use MotionMagic",
          "basis": "team",
          "src": [
            "s16"
          ]
        }
      ],
      "cost": [
        {
          "text": "It took a lot of tuning and engineering time",
          "basis": "team",
          "src": [
            "s12"
          ]
        },
        {
          "text": "Off-season: it broke on the practice day of an event (NEO encoder wires and a melted pulley), and its motors were changed to 550s",
          "basis": "team",
          "src": [
            "s13"
          ]
        }
      ]
    },
    {
      "name": "Vision and odometry",
      "pieces": [
        "note"
      ],
      "solves": [
        {
          "text": "Aim at the goal and find notes when tags or notes are out of sight",
          "basis": "team",
          "src": [
            "s12"
          ]
        }
      ],
      "does": [
        "sense"
      ],
      "type": "Limelight pose, note detection and odometry",
      "serves": [
        "speaker"
      ],
      "facts": [
        {
          "text": "Limelights on the front and bottom estimate pose from AprilTags; one on the back mainly tracks the source and feeding",
          "basis": "team",
          "src": [
            "s12"
          ]
        },
        {
          "text": "Odometry tracks the pose when tags are blocked, so aim stays on the goal; the team calls it always somewhat accurate",
          "basis": "team",
          "src": [
            "s12"
          ]
        },
        {
          "text": "Object detection gives a note's position so the robot can drive itself to it when the driver cannot see it",
          "basis": "team",
          "src": [
            "s12"
          ]
        }
      ]
    },
    {
      "name": "Plate structure",
      "does": [
        "structure"
      ],
      "type": "machined plate bracing",
      "serves": [],
      "facts": [
        {
          "text": "Zero structural failures anywhere on the robot all season, in answer to a question about how the plate bracing and cross members took impacts",
          "basis": "team",
          "src": [
            "s18",
            "s19"
          ]
        },
        {
          "text": "Bushings were not tight press fits, which would shrink them onto the rounded hex; shafts had axial float, and no bushing needed replacing",
          "basis": "team",
          "src": [
            "s20"
          ]
        },
        {
          "text": "Machined in house on a Tormach 770; longer pieces exceeded its travel, and angled tapped holes were done on a Bridgeport with a fixture",
          "basis": "team",
          "src": [
            "s19"
          ]
        }
      ]
    },
    {
      "name": "Climber",
      "does": [
        "endgame"
      ],
      "type": "Thrifty climber kit",
      "serves": [
        "onstage"
      ],
      "facts": [
        {
          "text": "A Thrifty climber bought as a kit",
          "basis": "team",
          "src": [
            "s21",
            "s22"
          ]
        }
      ]
    }
  ],
  "decisions": [
    {
      "choice": "Two intakes and no turret",
      "because": "a turret would add a lot of complexity and make handoff and intake harder",
      "instead_of": "a turret",
      "cost": "not quite the same as another team's turret, by the team's account",
      "basis": "team",
      "src": [
        "s12"
      ]
    },
    {
      "choice": "Differential shooter",
      "because": "notes without spin dove and flipped on long shots",
      "instead_of": "a shooter that gave no spin",
      "basis": "team",
      "src": [
        "s12"
      ]
    },
    {
      "choice": "Odometry for auto note pickup",
      "because": "note detection was way too slow in auto; used when the team expects to reach the line first",
      "instead_of": "driving by note detection",
      "basis": "team",
      "src": [
        "s12"
      ]
    },
    {
      "choice": "Plain bushings in a compact mount",
      "because": "compactness was preferred, with care on shaft alignment when tightening everything down",
      "instead_of": "a spherical bushing mount",
      "basis": "team",
      "src": [
        "s20"
      ]
    },
    {
      "choice": "Climber bought as a kit",
      "because": "the manufacturing students had no time to make one",
      "basis": "team",
      "src": [
        "s22"
      ]
    }
  ],
