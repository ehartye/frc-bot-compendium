  "decisions": [
    {
      "choice": "Ignore the trap",
      "because": "designing for it compromised the whole robot, its points were not worth it in eliminations, and other scoring reached the ranking point",
      "basis": "team",
      "src": [
        "s20"
      ]
    },
    {
      "choice": "An under-bumper intake",
      "because": "an open field meant heavy collisions, and under the bumper nothing gets hit",
      "basis": "team",
      "src": [
        "s19"
      ]
    },
    {
      "choice": "Top and bottom flywheels with high compression",
      "because": "the team wanted to shoot from partly past the stage, and saw side and less-compressed shooters stop at the podium",
      "instead_of": "side or lower-compression shooters",
      "basis": "team",
      "src": [
        "s19"
      ]
    },
    {
      "choice": "A pneumatic climber that drops on power loss",
      "because": "it allows very late climbs",
      "instead_of": "a rotary hanger, which would probably go on the end of the shooter and add stress and time",
      "basis": "team",
      "src": [
        "s19",
        "s6"
      ]
    },
    {
      "choice": "2D vision only",
      "because": "it processes at a much higher frame rate and needs no filtering or latency compensation",
      "instead_of": "3D pose estimation",
      "basis": "team",
      "src": [
        "s9"
      ]
    },
    {
      "choice": "A custom shoulder gearbox",
      "because": "it leaves ways to reduce backlash, fits the packaging, and the team can make it",
      "instead_of": "a planetary gearbox",
      "basis": "team",
      "src": [
        "s16"
      ]
    },
    {
      "choice": "Tip the flywheels down 6 degrees",
      "because": "it lowers the exit angle with far less effort, and leaves the note handoff alone",
      "instead_of": "lowering the arm's lowest angle",
      "basis": "team",
      "src": [
        "s7",
        "s3"
      ]
    },
    {
      "choice": "One flywheel speed for all shots",
      "because": "slowing up close hurt autos that shoot while driving away",
      "instead_of": "slower shots at close range",
      "cost": "some in-and-outs at close range",
      "basis": "team",
      "src": [
        "s12"
      ]
    },
    {
      "choice": "Make assembly drawings before building",
      "because": "they give a parts list and make assembly much easier",
      "cost": "they take a lot of time",
