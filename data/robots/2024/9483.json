  "story": {
    "bet": [
      {
        "text": "Give the driver less to do: climbing, the amp and shooting run automatically, using pose estimation as much as possible.",
        "basis": "team",
        "src": [
          "s3"
        ]
      }
    ],
    "auto": [
      {
        "text": "More than 10 autos to select.",
        "basis": "team",
        "src": [
          "s3"
        ]
      },
      {
        "text": "A reply to a February video, before the robot's reveal, compares it with the replier's own seven-note auto.",
        "basis": "observer",
        "src": [
          "s4"
        ]
      },
      {
        "text": "The team says it ran slightly out of time for an eighth note, and was unsure an eighth was worth it, since such autos would not be part of higher-level play.",
        "basis": "team",
        "src": [
          "s5"
        ]
      }
    ],
    "cycle": [
      {
        "text": "A sensor in the feeder sees the note and the shooter starts. Shooting angle and speed are set automatically. For the amp, the note stays at the intake and leaves like an outtake.",
        "basis": "team",
        "src": [
          "s3"
        ]
      }
    ],
    "endgame": [
      {
        "text": "The driver goes straight to the chain and pushes one button; the climb then runs by itself.",
        "basis": "team",
        "src": [
          "s3"
        ]
      }
    ],
    "fallback": [
      {
        "text": "When vision has trouble, the robot can still predict its location.",
        "basis": "team",
        "src": [
          "s3"
        ]
      }
    ],
    "gave_up": [
      {
        "text": "The climber is one shot: once opened it cannot be closed again.",
        "basis": "team",
        "src": [
          "s3"
        ]
      },
      {
        "text": "The team called its amp scoring probably its weakest link.",
        "basis": "team",
        "src": [
          "s6"
        ]
      }
    ],
    "outcome": [
      {
        "text": "37-9-0 in official play; won the Milstein division; pick 1 of the Milstein alliance on Einstein; ranked 53 by championship OPR (46.94, Milstein).",
        "basis": "record",
        "src": [
          "s1",
          "s2"
        ]
      }
    ]
  },
  "functions": [
    {
      "name": "Intake",
      "pieces": [
        "note"
      ],
      "solves": [
        {
          "text": "Grip notes with light rollers that do not break",
          "basis": "team",
          "src": [
            "s3"
          ]
        }
      ],
      "does": [
        "acquire",
        "transfer"
      ],
      "type": "roller intake on a pivot",
      "serves": [
        "speaker",
        "amp"
      ],
      "facts": [
        {
          "text": "Six rollers; the front ones carry cat-tongue tape for grip, since polycarbonate has little",
          "basis": "team",
          "src": [
            "s3"
          ]
        },
        {
          "text": "Aluminum shafts in the rollers keep them from breaking",
          "basis": "team",
          "src": [
            "s3"
          ]
        },
        {
          "text": "The pivot ratio is heard as about 1 to 7",
          "basis": "team",
          "src": [
            "s3"
          ]
        }
      ],
      "cost": [
        {
          "text": "In one practice match the intake took a big hit and was clearly broken; the pit students had spares out before the match ended",
          "basis": "observer",
          "src": [
            "s7"
          ]
        }
      ]
    },
    {
