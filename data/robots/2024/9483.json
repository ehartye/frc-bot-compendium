          ]
        }
      ],
      "does": [
        "deliver",
        "position"
      ],
      "type": "pivoting dead-axle shooter",
      "serves": [
        "speaker"
      ],
      "facts": [
        {
          "text": "Dead axle with an aluminum tube and cat tongue",
          "basis": "team",
          "src": [
            "s3"
          ]
        },
        {
          "text": "Angle goes from about 17 to about 65 (degrees not spoken)",
          "basis": "team",
          "src": [
            "s3"
          ]
        },
        {
          "text": "Angle and speed are automatic",
          "basis": "team",
          "src": [
            "s3"
          ]
        },
        {
          "text": "A forum poster lists 9483 among the 2024 robots to study for shooting",
          "basis": "observer",
          "src": [
            "s8"
          ]
        }
      ]
    },
    {
      "name": "Amp scoring from the intake",
      "pieces": [
        "note"
      ],
      "does": [
        "deliver"
      ],
      "type": "intake outtake",
      "serves": [
        "amp"
      ],
      "facts": [
        {
          "text": "A button activates the sensors on the intake; the note stays there and leaves like an outtake",
          "basis": "team",
          "src": [
            "s3"
          ]
        },
        {
          "text": "Pose estimation lines the robot up for it",
          "basis": "team",
          "src": [
            "s3"
          ]
        },
        {
          "text": "The season ended with the geometry drawn in CAD at its start",
          "basis": "team",
          "src": [
            "s6"
          ]
        },
        {
          "text": "A forum poster says the team proved amp scoring from the intake could be done consistently; the team still calls it its weakest link",
          "basis": "observer",
          "src": [
            "s14"
          ]
        }
      ],
      "cost": [
        {
          "text": "Probably the robot's weakest link, by the team's own account",
          "basis": "team",
          "src": [
            "s6"
          ]
        }
      ]
