      ],
      "cost": [
        {
          "text": "A build-thread post that reads as the team's says it was bent in collisions at both district events",
          "basis": "observer",
          "src": [
            "s12"
          ]
        },
        {
          "text": "A build-thread post that reads as the team's says long belt runs had high friction, about 30 A to run, until the shooter moved in",
          "basis": "observer",
          "src": [
            "s13"
          ]
        }
      ]
