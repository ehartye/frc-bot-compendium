        "amp",
        "trap"
      ],
      "facts": [
        {
          "text": "On the back of the robot",
          "basis": "team",
          "src": [
            "s14"
          ]
        },
        {
          "text": "Two leading rollers with small wedges start centering the note",
          "basis": "team",
          "src": [
            "s14"
          ]
        },
        {
          "text": "Passive rollers with slippery tape finish centering",
          "basis": "team",
          "src": [
            "s14"
          ]
        }
      ]
    },
    {
