  "story": {
    "bet": [],
    "demand": [],
    "auto": [
      {
        "text": "A routine is set up by answering questions such as start position and number of spike notes. A newer 'thinking on your feet' routine sweeps the center line until it gets a note, then shoots from the nearest scoring place. Localization brings the robot back to its path after contact.",
        "basis": "team",
        "src": [
          "s14"
        ]
      }
    ],
    "cycle": [
      {
        "text": "A note enters under the bumper at the back, is centered by rollers, and passes a kicker roller into the indexer, which sends it to the shooter or to the amp backpack; the team can switch while the note is inside. For the amp, the arm raises as the note runs up and back down.",
        "basis": "team",
        "src": [
          "s14"
        ]
      }
    ],
    "endgame": [
      {
        "text": "Arm and hooks go up, the robot drives under the stage and chain, the chain drops into the hooks, the arm moves forward and the hooks pull down. The backpack then extends to score the trap; pulsing rollers keep a missed note in place for another try.",
        "basis": "team",
        "src": [
          "s14"
        ]
      }
    ],
    "fallback": [
      {
        "text": "If another team has taken center-line notes, the 'thinking on your feet' routine keeps sweeping; the team says it skipped notes that way in its last match.",
        "basis": "team",
        "src": [
          "s14"
        ]
      }
    ],
    "gave_up": [],
    "changed": [
      {
        "text": "Posts that read as the team's say: hits damaged the shooter at both district events, so before the district championship it moved closer to the frame, with beater bars, and running current fell from about 30 A to 8 A; fangs and a powered trap roller made climb and trap faster and more consistent; wheels went from orange to blue stealth and back to orange for far shots.",
        "basis": "observer",
        "src": [
          "s12",
          "s13"
        ]
      }
    ],
    "outcome": [
      {
        "text": "57-12-0 in official play; won the Hopper division; captain of the Hopper alliance on Einstein; ranked 7 of the pooled top 20 (OPR 56.85, Hopper).",
        "basis": "record",
        "src": [
          "s1",
          "s2"
        ]
      }
    ]
  },
  "functions": [
    {
      "name": "Intake",
      "pieces": [
        "note"
      ],
      "solves": [
        {
          "text": "Deliver a centered note to the arm from a full-width opening",
