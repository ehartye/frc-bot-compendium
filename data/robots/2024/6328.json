            "s13"
          ]
        }
      ],
      "does": [
        "deliver"
      ],
      "type": "flywheel shooter with independent sides",
      "serves": [
        "speaker"
      ],
      "facts": [
        {
          "text": "Each side is driven separately at a different speed, to spin the note for stable flight",
