  "decisions": [
    {
      "choice": "Two note paths from one indexer",
      "because": "the team needs to switch between shooter and amp or trap whenever it wants",
      "basis": "team",
      "src": [
        "s14"
      ]
    },
    {
      "choice": "Independently driven shooter sides",
      "because": "one half spinning faster spins the note and keeps its flight stable",
      "basis": "team",
      "src": [
        "s14"
      ]
    },
    {
      "choice": "Pull the shooter in",
      "because": "a build-thread post that reads as the team's says it needed to survive defense at the district and world championships",
      "basis": "observer",
      "src": [
        "s13"
      ]
    },
    {
      "choice": "Fangs for the chain",
      "because": "a build-thread post that reads as the team's says approaching from inside the stage with the arm rising let the chain catch after a slight positioning error",
      "basis": "observer",
      "src": [
        "s12"
      ]
    },
    {
      "choice": "Orange stealth wheels",
      "because": "a build-thread post that reads as the team's says new autos needed shots from near the wing line",
      "instead_of": "blue stealth wheels, used for looks at one event",
      "basis": "observer",
      "src": [
        "s13"
      ]
    },
    {
      "choice": "Shooter mounted on the inside of the tube",
      "because": "a build-thread post that reads as the team's says a spare shooter can be dropped in quickly",
      "instead_of": "a plate inside a printed block in the tube, which packed well but was very difficult to pry out",
      "basis": "observer",
      "src": [
        "s13"
      ]
    },
    {
      "choice": "Two Orange Pis",
      "because": "powering and setting up four was really difficult",
      "instead_of": "four boards, one per camera",
      "basis": "team",
      "src": [
        "s14"
      ]
    },
    {
      "choice": "Development robot from prototypes",
      "because": "it gave drive practice and auto time early, and showed assembly mistakes to fix in the real design",
      "basis": "team",
      "src": [
        "s14"
      ]
    }
  ],
