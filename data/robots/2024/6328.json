      "serves": [
        "speaker"
      ],
      "facts": [
        {
          "text": "An undated published commit holds one tunable shooting speed and sets arm angle in degrees as about 57.25 times distance in meters to the power -0.593, plus an adjustable correction",
          "basis": "team",
          "src": [
            "s15",
            "s16"
          ]
        },
        {
          "text": "It aims for a predicted pose, with separate look-ahead times in auto and teleop",
          "basis": "team",
          "src": [
            "s15"
          ]
        },
        {
          "text": "A separate long-distance mode has its own field target, with arm angle and wheel speed tables for about 26 to 34 ft, and corrects wheel speed for robot motion",
          "basis": "team",
          "src": [
            "s15"
          ]
        }
      ]
    },
    {
      "name": "Amp Backpack",
      "pieces": [
        "note"
