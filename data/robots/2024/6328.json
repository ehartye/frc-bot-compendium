          ]
        }
      ],
      "does": [
        "transfer"
      ],
      "type": "double-sided belt indexer with two exits",
      "serves": [
        "speaker",
        "amp",
        "trap"
      ],
      "facts": [
        {
          "text": "A kicker roller feeds it",
          "basis": "team",
          "src": [
            "s14"
          ]
        },
        {
          "text": "Double-sided belt reverses some rollers without gears, which helps packaging",
          "basis": "team",
          "src": [
            "s14"
          ]
        },
        {
          "text": "Shuffles a note between the shooter path and the amp and trap path",
          "basis": "team",
