  "story": {
    "bet": [],
    "demand": [],
    "auto": [
      {
        "text": "The robot is told to go to points on the field from its odometry, which the team says is more precise than motor encoders.",
        "basis": "team",
        "src": [
          "s4"
        ]
      }
    ],
    "cycle": [
      {
        "text": "The intake roller passes the note by a second roller to the shooter; sensors detect it and hold it in the same place. Odometry sets the shooter angle and the robot angle for the shot.",
        "basis": "team",
        "src": [
          "s4"
        ]
      }
    ],
    "endgame": [
      {
        "text": "The hooks rise, then lower a little; the elevator goes up and takes several angles to ease the climb. At the final angle the note slides along a small metal piece into the trap.",
        "basis": "team",
        "src": [
          "s4"
        ]
      }
    ],
    "fallback": [],
    "gave_up": [],
    "changed": [
      {
        "text": "The first large intake roller's covering was changed to wheels, and grip covering went on the other rollers. The center of mass was well balanced, but the team wanted the robot to lean forward, so the hooks moved backward for more tilt.",
        "basis": "team",
        "src": [
          "s4"
        ]
      }
    ],
    "outcome": [
      {
        "text": "49-11-1 in official play; finalist in the Newton division; ranked 8 of the pooled top 20 (OPR 56.33, Newton).",
        "basis": "record",
        "src": [
          "s1",
          "s2"
        ]
      }
    ]
  },
