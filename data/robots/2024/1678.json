            "s6"
          ]
        }
      ],
      "does": [
        "position",
        "deliver"
      ],
      "type": "single-stage elevator with amp and trap scoring",
      "serves": [
        "amp",
        "trap"
      ],
      "facts": [
        {
          "text": "Scores the amp and, with the climber, the trap",
          "basis": "team",
          "src": [
            "s6"
          ]
        },
        {
          "text": "Two Kraken X60s at the belly pan drive the elevator",
          "basis": "team",
          "src": [
            "s6"
          ]
        },
        {
          "text": "The week 7 blog calls the amp mechanism the ampvator and describes a new design to improve amp and trap ejection",
