  "decisions": [
    {
      "choice": "Over-the-bumper intake",
      "because": "it gives a larger acquisition zone and the driver can run into notes without worrying about the bumper",
      "instead_of": "an under-bumper intake",
      "basis": "team",
      "src": [
        "s19"
      ]
    },
    {
      "choice": "Polycarbonate intake plates with aluminum sides",
      "because": "the original plates bent a lot at the first competition, so the team went more flexible",
      "instead_of": "pocketed aluminum plates",
      "basis": "team",
      "src": [
        "s19"
      ]
    },
    {
      "choice": "Stow the note and choose where it goes later",
      "because": "a partner may find a stray note for the amp or a ferried note may land where it is wanted, so the choice is worth keeping",
      "instead_of": "committing each note to one place",
      "basis": "team",
      "src": [
        "s19"
      ]
    },
    {
      "choice": "Flywheels on one side of the shooter",
      "because": "shop testing found it gives a lot of spin, which brought accuracy",
      "basis": "team",
      "src": [
        "s19"
      ]
    },
    {
      "choice": "Switch to a new architecture after Beta",
      "because": "Beta's complicated design did not go well",
      "instead_of": "Beta's three pivoting arms",
      "basis": "team",
      "src": [
        "s19"
      ]
    }
