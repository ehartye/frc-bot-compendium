  "story": {
    "bet": [
      {
        "text": "Stow the note and choose amp, trap or shooter later, because the team does not always know where a note will be needed.",
        "basis": "team",
        "src": [
          "s19"
        ]
      }
    ],
    "demand": [
      {
        "text": "The intake was built for a large acquisition zone and a crucial role in field clean-up. For the championship the team worked on reaching the midline sooner, expecting more five- and six-note autos there.",
        "basis": "team",
        "src": [
          "s6",
          "s19"
        ]
      }
    ],
    "auto": [
      {
        "text": "A six-note routine, new for the championship, shoots the first two notes on the move. If the indexer beam breaks show no note, the robot slides along the midline to the next one instead of driving back to shoot.",
        "basis": "team",
        "src": [
          "s19"
        ]
      }
    ],
    "cycle": [
      {
        "text": "The intake funnels the note into the indexer; a triple point sends it up the elevator for the amp or out the back to the shooter. It can amp at once or hold the note.",
        "basis": "team",
        "src": [
          "s6",
          "s19"
        ]
      },
      {
        "text": "At East Bay, a post describes 1678 and another robot passing many notes to a shooting partner; a reply says note stealing seemed disruptive.",
        "basis": "observer",
        "src": [
          "s21"
        ]
      }
    ],
    "endgame": [
      {
        "text": "A wide pivot climber hooks the chain and pulls it down while passive rollers on the elevator roll up the stage. The amp mechanism then scores the trap.",
        "basis": "team",
        "src": [
          "s6"
        ]
      }
    ],
    "fallback": [
      {
        "text": "The intake comes off with six bolts, so a broken one can be swapped and fixed while the robot plays.",
        "basis": "team",
        "src": [
          "s19"
        ]
      },
      {
        "text": "Localization can switch between odometry only and full vision.",
        "basis": "team",
        "src": [
          "s19"
        ]
      }
    ],
    "gave_up": [
      {
        "text": "Asked what it would change, the team mentioned under-bumper intakes but preferred over-the-bumper for the larger acquisition zone. Its first over-bumper plates bent badly, sometimes outside the frame perimeter, and it still swapped the intake about once or twice a competition.",
        "basis": "team",
        "src": [
          "s19"
        ]
      }
    ],
    "changed": [
      {
        "text": "Alpha ran a five-note auto on day 6. Beta, with three pivoting arms, did not go well and the architecture was dropped. The interview counts three robots; the blog also names Epsilon before the competition robot.",
        "basis": "team",
        "src": [
          "s19",
          "s13"
        ]
      },
      {
        "text": "After the first event, pocketed aluminum intake plates became polycarbonate with aluminum sides.",
        "basis": "team",
        "src": [
          "s19"
        ]
      }
    ],
    "outcome": [
      {
        "text": "56-12-1 in official play; won the Archimedes division; pick 1 of the Archimedes alliance on Einstein; ranked 10 of the pooled top 20 (OPR 55.90, Archimedes).",
        "basis": "record",
        "src": [
          "s1",
          "s2"
        ]
      }
    ]
  },
  "functions": [
    {
      "name": "Drivetrain",
      "solves": [
        {
          "text": "Keep the center of gravity low and stop notes getting stuck under the robot",
          "basis": "team",
          "src": [
            "s6"
          ]
        }
      ],
      "does": [
        "drive",
        "structure"
      ],
      "type": "swerve",
      "serves": [],
      "facts": [
        {
          "text": "26 in by 26 in with MK4i swerve modules",
          "basis": "team",
          "src": [
            "s6"
          ]
        },
        {
          "text": "1/16 in unpocketed belly pan, light with the most surface for electronics",
          "basis": "team",
          "src": [
            "s6"
          ]
        },
        {
          "text": "A 1 in by 1 in tube between the rail and the swerve modules lowers the center of gravity and stops notes getting stuck underneath",
          "basis": "team",
          "src": [
            "s6"
          ]
        }
      ]
    },
    {
      "name": "Over-the-bumper intake",
      "pieces": [
        "note"
      ],
      "solves": [
        {
          "text": "Let the driver run into notes confidently without worrying about the bumper, over a large zone",
          "basis": "team",
          "src": [
            "s19"
          ]
        }
      ],
      "does": [
        "acquire"
      ],
      "type": "over-the-bumper roller intake",
      "serves": [
        "speaker",
        "amp",
        "trap"
      ],
      "facts": [
        {
          "text": "Polycarbonate about 6 mm thick, with aluminum on the sides",
          "basis": "team",
          "src": [
            "s19"
          ]
        },
        {
          "text": "5052 aluminum, so bent parts can be bent back",
          "basis": "team",
          "src": [
            "s19"
          ]
        },
        {
          "text": "Attached by six bolts for quick swaps",
          "basis": "team",
          "src": [
            "s19"
          ]
        },
        {
          "text": "3D-printed blocks funnel the note toward the indexer",
          "basis": "team",
          "src": [
            "s19"
          ]
        },
        {
          "text": "One motor",
          "basis": "team",
          "src": [
            "s6"
          ]
        },
        {
          "text": "Full width of the robot",
          "basis": "observer",
          "src": [
            "s20"
          ]
        }
      ],
      "cost": [
        {
          "text": "Plates bent at the first competition; after the change the team still swapped the intake about once or twice a competition",
          "basis": "team",
          "src": [
            "s19"
          ]
        }
      ]
    },
    {
      "name": "Indexer (triple point)",
      "pieces": [
        "note"
      ],
      "solves": [
        {
          "text": "Store the note, then send it to the amp or the shooter",
          "basis": "team",
          "src": [
            "s6",
            "s19"
          ]
        }
      ],
      "does": [
        "transfer",
        "retain"
      ],
      "type": "roller indexer that routes the note to elevator or shooter",
      "serves": [
        "speaker",
        "amp",
        "trap"
      ],
      "facts": [
        {
          "text": "Two beam breaks show that the note has entered and is held",
          "basis": "team",
          "src": [
            "s19"
          ]
        },
        {
          "text": "Flips up on the shooter's dead axle to reach the electronics",
          "basis": "team",
          "src": [
            "s6"
          ]
        },
        {
          "text": "In week 7 the team was swapping in a new indexer design meant to improve triple point efficiency",
          "basis": "team",
          "src": [
            "s13"
          ]
        }
      ]
    },
    {
      "name": "Elevator and ampvator",
