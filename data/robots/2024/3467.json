  "story": {
    "bet": [
      {
        "text": "One decently simple single-joint arm combines amp, shooter, shooter angle and climb, fed by an under-bumper intake.",
        "basis": "team",
        "src": [
          "s9",
          "s32"
        ]
      }
    ],
    "demand": [
      {
        "text": "Be the best note scorer possible and leave the trap: it is hard, and climbing beside a partner plus a last speaker cycle gives up 1 point against climb and trap.",
        "basis": "team",
        "src": [
          "s5",
          "s6"
        ]
      },
      {
        "text": "You win events by winning matches, not by the most ranking points.",
        "basis": "team",
        "src": [
          "s6"
        ]
      },
      {
        "text": "The week 1 list started with fitting under the stage, below 26 in.",
        "basis": "team",
        "src": [
          "s33"
        ]
      }
    ],
    "auto": [
      {
        "text": "Five notes from the subwoofer without vision; it averaged 4 at North Shore.",
        "basis": "team",
        "src": [
          "s22",
          "s23"
        ]
      },
      {
        "text": "Midline autos find notes with a Limelight and can take another if one is gone.",
        "basis": "team",
        "src": [
          "s22",
          "s32"
        ]
      },
      {
        "text": "At the championship, an amp-side rush reached the centerline note in about 2.33 s, but shots missed often until the second playoff match.",
        "basis": "team",
        "src": [
          "s29"
        ]
      }
    ],
    "cycle": [
      {
        "text": "Intake under the bumper, stop by beam break, then shoot from the subwoofer, from vision or on the move. Best match at North Shore: 11 notes in teleop.",
        "basis": "team",
        "src": [
          "s33",
          "s18",
          "s23"
        ]
      },
      {
        "text": "At the championship it cycled and cleaned up as a complement to partners; its passing was a bit sloppy sometimes and cleanup relied too much on the subwoofer shot.",
        "basis": "team",
        "src": [
          "s29"
        ]
      }
    ],
    "endgame": [
      {
        "text": "The arm hooks the chain and pulls down; alone, it climbed with 2 to 3 seconds left.",
        "basis": "team",
        "src": [
          "s26"
        ]
      },
      {
        "text": "Taller Harmony Hooks climbed beside another robot in four qualification matches at the New England Championship and three times, once in a replay, at the championship.",
        "basis": "team",
        "src": [
          "s27",
          "s29"
        ]
      },
      {
        "text": "The trap blower scored in practice matches, never in a qualification match.",
        "basis": "team",
        "src": [
          "s27",
          "s29"
        ]
      }
    ],
    "fallback": [
      {
        "text": "The subwoofer five-note auto works if cameras or arm do not.",
        "basis": "team",
        "src": [
          "s22"
        ]
      },
      {
        "text": "Aim runs on robot pose, so it continues on drivebase encoders if vision is lost.",
        "basis": "team",
        "src": [
          "s33"
        ]
      }
    ],
    "gave_up": [
      {
        "text": "Seeding first is difficult without the trap or a climb on a partner's chain, the team wrote after Greater Boston.",
        "basis": "team",
        "src": [
          "s24"
        ]
      },
      {
        "text": "A team member said the arm struggled for accuracy and reliability later in the season, and praised a team that moved climbing forces to separate climbers.",
        "basis": "team",
        "src": [
          "s35"
        ]
      },
      {
        "text": "The intake was very difficult to repair at the first event.",
        "basis": "team",
        "src": [
          "s21"
        ]
      }
    ],
    "changed": [
      {
        "text": "An Alpha robot with a fixed-angle shooter was dropped in January: poor centering and a handoff sensitive to shooter angle.",
        "basis": "team",
        "src": [
          "s8"
        ]
      },
      {
        "text": "After intake failures ended Granite State: dead axles, 1/4 in 7075 plates, full spares.",
        "basis": "team",
        "src": [
          "s21",
          "s22"
        ]
      },
      {
        "text": "Before the championship: polybelt between rear intake rollers for jams.",
        "basis": "team",
        "src": [
          "s28"
        ]
      },
      {
        "text": "A broken crimp clip on a CAN wire stopped the robot in its last Galileo match.",
        "basis": "team",
        "src": [
          "s29"
        ]
      }
    ],
    "outcome": [
      {
        "text": "59-22-1 in official play; ranked 38 by championship OPR (48.45, Galileo).",
        "basis": "record",
        "src": [
          "s1",
          "s2"
        ]
      }
    ]
  },
  "functions": [
    {
      "name": "Drivebase",
      "solves": [
        {
          "text": "Be fast going up and down the field",
          "basis": "team",
          "src": [
            "s33"
          ]
        }
      ],
      "does": [
        "drive",
        "structure"
      ],
      "type": "swerve",
      "serves": [],
      "facts": [
        {
          "text": "SDS MK4i modules with L3 gearing, Krakens for steering and driving; stated free speed",
          "basis": "team",
          "src": [
            "s33"
          ],
          "value": 18.0,
          "unit": "ft/s"
        },
        {
          "text": "Drive reduction 6.12:1",
          "basis": "team",
          "src": [
            "s33"
          ]
        },
        {
          "text": "Chassis 26.875 x 31 in, 2 x 1 in MAXTube",
          "basis": "team",
          "src": [
            "s33"
          ]
        },
        {
          "text": "1/8 in bellypan over most of the underside to lower the center of gravity",
          "basis": "team",
          "src": [
            "s33"
          ]
        },
        {
          "text": "The front bumper plywood is shaped to rise in front and keeps the required backing; angle brackets join it to the sides",
          "basis": "team",
          "src": [
            "s30"
          ]
        }
      ]
    },
    {
      "name": "Arm",
      "pieces": [
        "note"
      ],
      "solves": [
        {
          "text": "Reach amp, subwoofer, distance-shot and climb positions with one joint",
          "basis": "team",
          "src": [
            "s9",
            "s32"
          ]
        }
      ],
      "cost": [
        {
          "text": "Before Week 0 a climb broke one of the 25H arm chains; the hooks were then moved 2.5 in toward the pivot",
          "basis": "team",
          "src": [
            "s15"
          ]
        },
        {
          "text": "The climbing chain could pinch wires routed to the arm",
          "basis": "team",
          "src": [
            "s15"
          ]
        },
        {
          "text": "Accuracy and reliability struggled later in the season, a team member said",
          "basis": "team",
          "src": [
            "s35"
          ]
        }
      ],
      "does": [
        "position",
        "deliver",
        "endgame"
      ],
      "type": "single-joint arm",
      "serves": [
        "speaker",
        "amp",
        "onstage"
      ],
      "facts": [
        {
          "text": "Two Falcons, each on its own 49:1 MAX Planetary gearbox with a 90 degree output, drive one central axle",
          "basis": "team",
          "src": [
            "s33"
          ]
        },
        {
          "text": "16T sprocket drives a 64T MAXSpline sprocket; the team found a large tooth ratio gives minimal backlash",
          "basis": "team",
          "src": [
            "s33"
          ]
        },
        {
          "text": "Number 25H chains with turnbuckles",
          "basis": "team",
          "src": [
            "s33"
          ],
          "value": 4,
          "unit": "chains"
        },
        {
          "text": "REV Through Bore Encoder on the arm's live ThunderHex axle, replacing 2023's printed encoder gears that were shimmed at every competition",
          "basis": "team",
          "src": [
            "s10",
            "s14",
            "s33"
          ]
        },
        {
          "text": "Steel hex hardstop at the bottom allows a faster subwoofer shot and does not bend",
          "basis": "team",
          "src": [
            "s33"
          ]
        },
        {
          "text": "Motion is a trapezoidal profile with WPILib arm feedforward",
          "basis": "team",
          "src": [
            "s12"
          ]
        },
        {
          "text": "Climbing uses an automatic setpoint that does not bottom out on the hardstops, instead of manual control",
          "basis": "team",
          "src": [
            "s15"
          ]
        },
        {
          "text": "The shooter assembly weighed 22 lb, and the gearbox ratio was increased to make sure the arm was strong enough",
          "basis": "team",
          "src": [
            "s17"
          ]
        }
      ]
    },
    {
      "name": "Shooter",
      "pieces": [
        "note"
      ],
      "solves": [
        {
          "text": "Shoot consistently from many distances while light enough for the arm",
          "basis": "team",
          "src": [
            "s33"
          ]
        }
      ],
      "cost": [
        {
          "text": "A shooter plate snapped in the New England Championship playoffs",
          "basis": "team",
          "src": [
            "s27"
          ]
        }
      ],
      "does": [
        "deliver"
      ],
      "type": "flywheels on the arm",
      "serves": [
        "speaker"
      ],
      "facts": [
        {
          "text": "ThriftyBot 4 in wheels",
          "basis": "team",
          "src": [
            "s33"
          ],
          "value": 8,
          "unit": "wheels"
        },
        {
          "text": "Each side driven by one Falcon 500 at 1:1.625 for more speed",
          "basis": "team",
          "src": [
            "s33"
          ]
        },
        {
          "text": "The sides ran at different speeds in January testing to spin the note",
          "basis": "team",
          "src": [
            "s11"
          ]
        },
        {
          "text": "Horizontal wheels replaced a first vertical layout because they were found more accurate",
          "basis": "team",
          "src": [
            "s32"
          ]
        },
        {
          "text": "Gears changed from mixed-vendor aluminum to printed Onyx, and it ran smoother",
          "basis": "team",
          "src": [
            "s19"
          ]
        },
        {
          "text": "A resting speed saves spin-up time",
          "basis": "team",
          "src": [
            "s19"
          ]
        },
        {
          "text": "1/4 in polycarbonate plates",
          "basis": "team",
          "src": [
            "s16"
          ]
        }
      ]
    },
    {
      "name": "Stage",
      "pieces": [
        "note"
      ],
      "solves": [
        {
          "text": "Hold the note behind the shooter and give it speed before the wheels, with no separate mechanism",
          "basis": "team",
          "src": [
            "s33"
          ]
        }
      ],
      "does": [
        "transfer",
        "retain"
      ],
      "type": "roller feeder behind the shooter",
      "serves": [
        "speaker",
        "amp"
      ],
      "facts": [
        {
          "text": "1.125 in VersaRollers on a Bag motor with a 3:1 VersaPlanetary",
          "basis": "team",
          "src": [
            "s33"
          ]
        },
        {
          "text": "Grip tape on the rollers; they feed two HDPE panels for low friction",
          "basis": "team",
          "src": [
            "s33"
          ]
        },
        {
          "text": "A beam break tells when a note is held",
          "basis": "team",
          "src": [
            "s18"
          ]
        }
      ]
    },
    {
      "name": "Under-bumper intake",
      "pieces": [
        "note"
      ],
      "solves": [
        {
          "text": "Own the note on touch and survive ramming",
          "basis": "team",
          "src": [
            "s33",
            "s32"
          ]
        }
      ],
      "cost": [
        {
          "text": "At Granite State it broke after a hit in the first match and again in a physical playoff match; parts were very difficult to replace and it could not be fixed before the next match, which was lost",
          "basis": "team",
          "src": [
            "s21"
          ]
        },
        {
          "text": "Occasional jams cost a few seconds, or auto fouls for holding several notes",
          "basis": "team",
          "src": [
            "s28"
          ]
        },
        {
          "text": "A bolt holding a dead-axle roller sheared at the New England Championship",
          "basis": "team",
          "src": [
            "s27"
          ]
        },
        {
          "text": "It picks up well as long as it is driven into the note at a decent speed",
          "basis": "team",
          "src": [
            "s32"
          ]
        }
      ],
      "does": [
        "acquire"
      ],
      "type": "under-bumper roller intake with passive centering",
      "serves": [
        "speaker",
        "amp"
      ],
      "facts": [
        {
          "text": "1.125 in polycarbonate VersaRollers, with \"cheerio\" wheels on the front roller",
          "basis": "team",
          "src": [
            "s33"
          ]
        },
        {
          "text": "The March binder says 1.5:1 off a single Falcon; team members at Greater Boston said two Falcons power the back rollers",
          "basis": "team",
          "src": [
            "s33",
            "s32"
          ]
        },
        {
          "text": "Passive centering wedges 6 in long",
          "basis": "team",
          "src": [
            "s33"
          ]
        },
        {
          "text": "Teflon tape on the wedges cuts friction",
          "basis": "team",
          "src": [
            "s32"
          ]
        },
        {
          "text": "Stops by itself when a beam break sees a note, since it cannot be lifted to refuse a second one",
          "basis": "team",
          "src": [
            "s33",
            "s18"
          ]
        },
        {
          "text": "From March: dead-axle rollers and 1/4 in 7075 aluminum plates, with full spares",
          "basis": "team",
          "src": [
            "s22"
          ]
        },
        {
          "text": "From the championship: polybelt between the rear rollers helps pull the note up",
          "basis": "team",
          "src": [
            "s28"
          ]
        }
      ]
    },
    {
      "name": "Harmony Hooks",
      "solves": [
        {
          "text": "Reach a higher chain beside a climbed partner and still climb in the last seconds",
          "basis": "team",
          "src": [
            "s26"
          ]
        }
      ],
      "cost": [
        {
          "text": "Four climbs beside a partner at the New England Championship gave one Ensemble ranking point, often because some robot touched the ground",
          "basis": "team",
          "src": [
            "s27"
          ]
        }
      ],
      "does": [
        "endgame"
      ],
      "type": "fixed hooks on the arm",
      "serves": [
        "onstage"
      ],
      "facts": [
