  "story": {
    "bet": [
      {
        "text": "A one-piece billet chassis, so that the robot can zip around the field and the driver need not worry about it surviving.",
        "basis": "team",
        "src": [
          "s3"
        ]
      }
    ],
    "cycle": [
      {
        "text": "One forum post calls 2910 the best passer at the championship besides 4613.",
        "basis": "observer",
        "src": [
          "s4"
        ]
      },
      {
        "text": "Another says that in a championship match against 2056's alliance it stole shuttled notes and sent them back across the field.",
        "basis": "observer",
        "src": [
          "s5"
        ]
      },
      {
        "text": "A 1678 post says 1678 played the clean-up role in the alliance 4613 led.",
        "basis": "observer",
        "src": [
          "s6"
        ]
      }
    ],
    "endgame": [
      {
        "text": "At a regional: a single hook that attaches to any part of the chain. With the robot moved to one side it climbs with another robot.",
        "basis": "team",
        "src": [
          "s7"
        ]
      }
    ],
    "changed": [
      {
        "text": "Shortly before its regional the chassis was extended to share bumpers with 8613, as there was no luggage space for two sets, and rollers were added to the intake.",
        "basis": "team",
        "src": [
          "s7"
        ]
      },
      {
        "text": "Two posts say it was rebuilt for the championship, or was not the reveal robot.",
        "basis": "observer",
        "src": [
          "s8",
          "s9"
        ]
      }
    ],
    "outcome": [
      {
        "text": "44-4-1 in official play; won the Archimedes division; captain of the Archimedes alliance on Einstein; ranked 46 by championship OPR (47.26, Archimedes).",
        "basis": "record",
        "src": [
          "s1",
          "s2"
        ]
      }
    ]
  },
  "functions": [
    {
      "name": "Billet chassis (reveal and regional robot)",
      "solves": [
        {
          "text": "Take high-speed collisions without bending or wearing through an event",
          "basis": "team",
          "src": [
            "s3"
          ]
        }
      ],
      "does": [
        "structure",
        "drive"
      ],
      "type": "one-piece machined plate chassis",
      "serves": [],
      "facts": [
        {
          "text": "Machined from one piece of aluminium, thickness",
          "basis": "team",
          "src": [
            "s10",
            "s7"
          ],
          "value": 25,
          "unit": "mm"
        },
        {
          "text": "Cutting time, around",
          "basis": "team",
          "src": [
            "s11"
          ],
          "value": 5,
          "unit": "hours"
        },
        {
          "text": "Material cost per belly pan, around; a full sheet makes six",
          "basis": "team",
          "src": [
            "s10"
          ],
          "value": 200,
          "unit": "USD"
        },
        {
          "text": "Custom bumper brackets leave no gap to the chassis, and attachments for other systems are slotted in",
          "basis": "team",
          "src": [
            "s3"
          ]
        },
        {
          "text": "A poster who says he asked the team gives a frame of 600 mm by 600 mm at the reveal",
          "basis": "observer",
          "src": [
            "s12"
          ]
        },
        {
          "text": "A poster says the swerve looks like modified MK4i",
          "basis": "observer",
          "src": [
            "s13"
          ]
        },
        {
          "text": "A poster says the team milled it on its own large gantry router",
          "basis": "observer",
          "src": [
            "s14"
          ]
        }
      ]
    },
    {
      "name": "Under-bumper intake (regional robot)",
      "pieces": [
        "note"
      ],
      "solves": [
        {
          "text": "Pick up a note by driving over it, without the time to flip something out over the bumper",
          "basis": "team",
          "src": [
            "s7"
          ]
        }
      ],
      "does": [
        "acquire",
        "sense"
      ],
      "type": "under-the-bumper intake on low-friction sliders",
      "serves": [],
      "facts": [
        {
          "text": "The note goes in underneath the bumper and rolls along sliding parts with almost no friction",
          "basis": "team",
          "src": [
            "s7"
          ]
        },
        {
          "text": "Two line break sensors track the note inside the intake",
          "basis": "team",
          "src": [
            "s7"
          ]
        },
        {
          "text": "Rollers added with the longer chassis let it pick up from multiple positions",
          "basis": "team",
          "src": [
            "s7"
          ]
        }
      ]
    },
    {
      "name": "Fixed shooter (reveal and regional robot)",
      "pieces": [
        "note"
      ],
      "solves": [
        {
          "text": "Score in the amp too, without a pivot",
          "basis": "team",
          "src": [
            "s7",
            "s15"
          ]
        }
      ],
      "cost": [
        {
          "text": "Amp scoring is consistent only as long as the notes are not destroyed",
          "basis": "team",
          "src": [
            "s15"
          ]
        }
      ],
      "does": [
        "deliver"
      ],
      "type": "two-roller shooter without a pivot",
      "serves": [
        "amp"
      ],
      "facts": [
        {
          "text": "Two rollers on two separate motors can run at different speeds",
          "basis": "team",
          "src": [
            "s7"
          ]
        },
        {
          "text": "Top and bottom wheels have different durometers; in the automatic captions of the interview the lower wheels have the lower one, which makes the note curve into the amp",
          "basis": "team",
          "src": [
            "s15",
            "s7"
          ]
        }
      ]
    },
    {
      "name": "Climber (regional robot)",
      "solves": [
        {
          "text": "Hang from any part of the chain, next to another robot",
          "basis": "team",
          "src": [
            "s7"
          ]
        }
      ],
      "does": [
        "endgame"
      ],
      "type": "single-hook two-stage climber",
      "serves": [
        "onstage"
      ],
      "facts": [
        {
          "text": "Two stages, raised by constant force springs and winched down by one Falcon",
          "basis": "team",
          "src": [
            "s7"
          ]
        },
        {
          "text": "Winch reduction as captioned, about",
          "basis": "team",
          "src": [
            "s7"
          ],
          "value": 64,
          "unit": ":1"
        },
        {
          "text": "An added guard keeps a note that falls back onto the robot off the climber, where it could disable the robot for the rest of the match",
          "basis": "team",
          "src": [
            "s7"
          ]
        }
      ]
    }
  ],
  "decisions": [
    {
      "choice": "A one-piece billet chassis",
      "because": "the team says it is pretty much indestructible, never bends swerve plates, and makes autonomous more reliable because the robot does not wear",
      "basis": "team",
      "src": [
        "s3"
      ]
    },
    {
      "choice": "An under-bumper intake",
      "because": "it is easier to roll over the note than to spend time flipping something out over the bumper",
      "instead_of": "an intake that flips out over the bumper",
      "basis": "team",
      "src": [
        "s7"
      ]
    },
    {
      "choice": "A shooter without a pivot",
      "because": "the team says it is a lot more robust and reliable",
      "instead_of": "a pivoting shooter",
      "basis": "team",
      "src": [
        "s7"
      ]
    },
    {
      "choice": "Share bumpers with 8613",
      "because": "there was no luggage space for two sets",
      "cost": "the chassis was extended shortly before the regional",
      "basis": "team",
      "src": [
        "s7"
      ]
    }
  ],
