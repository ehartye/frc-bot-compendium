  "story": {
    "bet": [
      {
        "text": "Design for redundancy: as few failure modes as possible, and a backup for everything.",
        "basis": "team",
        "src": [
          "s11"
        ]
      }
    ],
    "demand": [],
    "auto": [
      {
        "text": "Eight autos, with those that go for the middle notes given priority. Each must work three times in a row on the practice field before it counts as ready. Shooting from as far as the wing line helps the higher-note ones.",
        "basis": "team",
        "src": [
          "s11"
        ]
      }
    ],
    "cycle": [
      {
        "text": "The intake passes a note up into the shooter, where indexer rollers hold it. The robot turns itself to the source or amp angle, or locks on to the speaker and stops the shot to re-aim if bumped.",
        "basis": "team",
        "src": [
          "s11"
        ]
      }
    ],
    "endgame": [
      {
        "text": "Two climbers make a harmony climb easy and cope with a chain that is not perfectly aligned. Either can lift the robot alone.",
        "basis": "team",
        "src": [
          "s11"
        ]
      }
    ],
    "fallback": [
      {
        "text": "If the intake fails, the shooter tilts back to take notes from the source. A note stuck in the intake can be spat out. One climber is enough to climb.",
        "basis": "team",
        "src": [
          "s11"
        ]
      }
    ],
    "gave_up": [
      {
        "text": "A forum reply says the robot did not score in the trap.",
        "basis": "observer",
        "src": [
          "s14"
        ]
      }
    ],
    "changed": [
      {
        "text": "At Bonney Lake a climber broke and was taken off for repair; the robot still climbed for the next three matches.",
        "basis": "team",
        "src": [
          "s11"
        ]
      },
      {
        "text": "The chosen layout had no amp bar until a tested RI3D idea inspired one, and a second bottom shooter roller was added after a prototype shot above the bar.",
        "basis": "team",
        "src": [
          "s12",
          "s13"
        ]
      }
    ],
    "outcome": [
      {
        "text": "43-22-0 in official play; ranked 20 of the pooled top 20 (OPR 52.33, Newton).",
        "basis": "record",
        "src": [
          "s1",
          "s2"
        ]
      }
    ]
  },
  "functions": [
    {
      "name": "Intake",
      "pieces": [
        "note"
      ],
      "solves": [
        {
          "text": "Pick up notes with few rollers, so it pivots quickly and stays inside the robot as much as possible",
          "basis": "team",
          "src": [
            "s11"
          ]
        }
      ],
      "does": [
        "acquire"
      ],
      "type": "over-bumper pivoting roller intake",
      "serves": [
        "speaker",
        "amp"
      ],
      "facts": [
        {
          "text": "Early prototyping showed only this many rollers were needed",
          "basis": "team",
          "src": [
            "s11"
          ],
          "value": 4,
          "unit": "rollers"
        },
        {
          "text": "Note compression",
          "basis": "team",
          "src": [
            "s12"
          ],
          "value": 0.2,
          "unit": "in"
        }
      ]
    },
    {
      "name": "Indexer rollers",
      "pieces": [
        "note"
      ],
      "solves": [
        {
          "text": "Score the amp with no additional mechanism to fail",
          "basis": "team",
          "src": [
            "s11"
          ]
        }
      ],
      "does": [
        "retain",
        "transfer",
        "deliver"
      ],
      "type": "rollers in the shooter shared by holding and amp scoring",
      "serves": [
        "amp",
        "speaker"
      ],
      "facts": [
        {
          "text": "They hold the note in the shooter and eject it behind the amp bar",
          "basis": "team",
          "src": [
            "s11"
          ]
        }
      ]
    },
    {
      "name": "Amp bar",
      "pieces": [
        "note"
      ],
      "solves": [
        {
          "text": "Keep the ejected note in the amp without adding a motor",
          "basis": "team",
          "src": [
            "s11"
          ]
        }
      ],
      "does": [
        "deliver"
      ],
      "type": "bar deployed by a virtual four-bar",
      "serves": [
        "amp"
      ],
      "facts": [
        {
          "text": "The virtual four-bar runs back to the main pivot axle, so the bar needs no motor of its own",
          "basis": "team",
          "src": [
            "s11"
          ]
        },
        {
          "text": "Inspired by an RI3D idea the team tested",
          "basis": "team",
          "src": [
            "s13"
          ]
        }
      ]
    },
    {
      "name": "Shooter",
      "pieces": [
        "note"
      ],
      "solves": [
        {
          "text": "Give stable shots from as far as the wing line",
          "basis": "team",
          "src": [
            "s11"
          ]
        }
      ],
      "does": [
        "deliver",
        "position",
        "acquire"
      ],
      "type": "pivoting wheeled shooter with separate top and bottom motors",
      "serves": [
        "speaker"
      ],
      "facts": [
        {
          "text": "Stealth wheels, diameter about",
          "basis": "team",
          "src": [
            "s11"
          ],
          "value": 2,
          "unit": "in"
        },
        {
          "text": "A separate NEO drives each axle",
          "basis": "team",
          "src": [
            "s11"
          ]
        },
        {
          "text": "One side has two wheels and the other five, which spins the note",
          "basis": "team",
          "src": [
            "s11"
          ]
        },
        {
          "text": "It can tilt back and take notes from the source",
          "basis": "team",
          "src": [
            "s11"
          ]
        },
        {
          "text": "Two rollers on the bottom and one on top; the second bottom one helps the note bend into the amp and sped up intaking",
          "basis": "team",
          "src": [
            "s12"
          ]
        },
        {
          "text": "Note compression, with none horizontally",
          "basis": "team",
          "src": [
            "s12"
          ],
          "value": 0.5,
          "unit": "in"
        }
      ]
    },
    {
      "name": "Climbers",
      "solves": [
        {
          "text": "Still climb when one climber has failed",
          "basis": "team",
          "src": [
            "s11"
          ]
        }
      ],
      "does": [
        "endgame"
      ],
      "type": "two independent two-motor climbers",
      "serves": [
        "onstage"
      ],
      "facts": [
        {
          "text": "Each climber has two NEOs",
          "basis": "team",
          "src": [
            "s11"
          ]
        },
        {
          "text": "With one climber off the robot, it climbed for three matches at Bonney Lake",
          "basis": "team",
          "src": [
            "s11"
          ]
        }
      ]
    },
    {
      "name": "Speaker lock",
      "solves": [
        {
          "text": "Avoid shooting when the robot has been bumped, turned away or lost the tag",
          "basis": "team",
          "src": [
            "s11"
          ]
        }
      ],
      "does": [
        "sense",
        "position"
      ],
      "type": "Limelight field pose with a lock-on check",
      "serves": [
        "speaker"
      ],
      "facts": [
        {
          "text": "The field pose is compared with the speaker tag's pose; through brief tag loss the robot re-angles toward the speaker",
          "basis": "team",
          "src": [
            "s11"
          ]
        },
        {
          "text": "If the lock is lost it stops shooting and re-angles",
          "basis": "team",
          "src": [
            "s11"
          ]
        }
      ]
    },
    {
      "name": "Field angle alignment",
      "pieces": [
        "note"
      ],
      "solves": [
        {
          "text": "Make source pickup and amp scoring easier",
          "basis": "team",
          "src": [
            "s11"
          ]
        }
      ],
      "does": [
        "sense",
        "position"
      ],
      "type": "automatic turn to source and amp angles",
      "serves": [
        "amp"
      ],
      "facts": [
        {
          "text": "The robot turns to the set angle by itself",
          "basis": "team",
          "src": [
            "s11"
          ]
        }
      ]
    }
  ],
  "decisions": [
    {
      "choice": "Over-bumper intake",
      "because": "it was proven and the team knew it could build it",
      "basis": "team",
      "src": [
        "s11"
      ]
    },
    {
      "choice": "Amp scoring with the indexer rollers",
      "because": "it removes a point of failure",
      "instead_of": "an additional amp mechanism",
      "basis": "team",
      "src": [
        "s11"
      ]
    },
    {
      "choice": "Amp bar on a virtual four-bar",
      "because": "there is no extra motor to burn out and it is simple to control",
      "instead_of": "an additional motor",
      "basis": "team",
      "src": [
        "s11"
      ]
    },
    {
      "choice": "Two motors per climber",
      "because": "one climber can lift the robot if the other fails",
      "basis": "team",
      "src": [
        "s11"
      ]
    },
    {
      "choice": "Unequal wheel counts on the two sides of the shooter",
      "because": "the note spins, which makes shots much more stable",
      "basis": "team",
      "src": [
        "s11"
      ]
    },
    {
      "choice": "Second bottom shooter roller",
      "because": "the one-roller prototype shot above the amp bar and could not score the amp",
      "instead_of": "one roller on the bottom",
      "basis": "team",
      "src": [
        "s12"
      ]
    }
  ],
