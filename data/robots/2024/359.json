  "decisions": [
    {
      "choice": "Build on 2910's robot",
      "because": "it already had subsystems this game needed, and experience with the multistage arm, pivot and intake made the short build possible",
      "basis": "team",
      "src": [
        "s8",
        "s13"
      ],
      "cost": "geometry to meet that year's rules and constraints made it harder than it seems"
    },
    {
      "choice": "One-stage telescoping arm",
      "because": "the robot did not need to extend that far out of its frame to score",
      "instead_of": "a third stage",
      "basis": "team",
      "src": [
        "s8"
      ]
    },
    {
      "choice": "Top and bottom shooter",
      "because": "prototypes gave the best compression, and the pivot can flatten the shot",
      "basis": "team",
      "src": [
        "s8"
      ]
    },
    {
      "choice": "Fold the intake when a robot approaches",
      "because": "it prevents damage in midline rushes",
      "basis": "team",
      "src": [
        "s8"
      ]
    },
    {
      "choice": "Intake and shooter on opposite sides",
      "because": "it minimizes spinning the robot",
      "basis": "team",
      "src": [
        "s4"
      ]
    },
    {
      "choice": "Offset dead-axle pivot",
      "because": "it is stiffer, sits low when stowed and reaches farther when scoring",
      "basis": "team",
      "src": [
        "s4"
      ]
    },
    {
      "choice": "Setpoints for almost every control",
      "because": "they cut human error and adjust easily between fields",
      "basis": "team",
      "src": [
        "s4"
      ]
    },
    {
      "choice": "No pneumatics",
      "because": "they add plumbing, weight and space for compressor and tanks, and one leak fails everything pneumatic",
      "cost": "moving something between two positions is much easier with pneumatics",
      "basis": "team",
      "src": [
        "s14",
        "s15",
        "s16"
      ]
    }
  ],
