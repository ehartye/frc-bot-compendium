  "story": {
    "outcome": [
      {
        "text": "68-10-1 in official play; ranked 19 of the pooled top 20 (OPR 52.42, Newton).",
        "basis": "record",
        "src": [
          "s1",
          "s2"
        ]
      }
    ],
    "bet": [
      {
        "text": "Start from 2910's robot, which the team ran in the off-season, because it already had several subsystems this game needed.",
        "basis": "team",
        "src": [
          "s8"
        ]
      }
    ],
    "demand": [
      {
        "text": "Ranking points first: as many notes as possible in teleop, then the stage. The trap matters because one trap note with two robots onstage can earn a ranking point. The three goals were adaptable autos, tolerant cycles and quick stage engagement.",
        "basis": "team",
        "src": [
          "s4"
        ]
      }
    ],
    "auto": [
      {
        "text": "The team wrote many autos from amp, center and stage starts to fit its partners, up to the preload plus four more notes. Odometry enables trajectory following, and Path Planner 2.0 speeds up creating and testing autos.",
        "basis": "team",
        "src": [
          "s4"
        ]
      }
    ],
    "cycle": [
      {
        "text": "The robot turns to a note seen by the Limelight, and the intake takes it and flips in to feed the shooter. A live firing solution sets the subsystems and fires as soon as all are ready. Intake and shooter on opposite sides mean less spinning.",
        "basis": "team",
        "src": [
          "s4",
          "s8"
        ]
      }
    ],
    "endgame": [
      {
        "text": "Pose estimation lines the robot up with the stage. One button moves everything into position; on the chain, a second one climbs. Carbon fiber rods prop under the stage and hold the robot near the trap.",
        "basis": "team",
        "src": [
          "s4",
          "s8"
        ]
      }
    ],
    "fallback": [
      {
        "text": "If pose estimation fails, setpoints tuned to known field spots still score, and operators can switch to manual. A second CAN bus covers a break in the first.",
        "basis": "team",
        "src": [
          "s8",
          "s4"
        ]
      }
    ],
    "changed": [
      {
        "text": "After the Canadian Pacific event one shooter wheel was moved over to add spin, for longer, more consistent shots. The forks came late in build season.",
        "basis": "team",
        "src": [
          "s8"
        ]
      },
      {
        "text": "On real stages the trap proved harder than at home: notes stuck to the polycarbonate.",
        "basis": "team",
        "src": [
          "s9"
        ]
      },
      {
        "text": "A servo that opens the trap door, added at San Diego, greatly improved consistency.",
        "basis": "team",
        "src": [
          "s8"
        ]
      }
    ]
  },
