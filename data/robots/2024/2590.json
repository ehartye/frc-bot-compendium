  "story": {
    "bet": [],
    "demand": [],
    "auto": [
      {
        "text": "The team page, written before its first event, lists many paths that combine notes near the speaker and at the center, for both alliance colors, and says the robot can take in and score up to five notes in one auto.",
        "basis": "team",
        "src": [
          "s3"
        ]
      }
    ],
    "cycle": [
      {
        "text": "An intake camera finds a note and the robot can turn to face it. The note passes through a full-width intake to a handoff point and into the shooter, and the shoulder snaps to the angle set from the AprilTags.",
        "basis": "team",
        "src": [
          "s3"
        ]
      }
    ],
    "endgame": [
      {
        "text": "The same page says a chain pulls a hook from the top of the robot nearly to the belly pan, high enough to score in the trap without tipping; the shoulder then pivots up and forces the note into the trap door.",
        "basis": "team",
        "src": [
          "s3"
        ]
      }
    ],
    "fallback": [],
    "gave_up": [],
    "changed": [
      {
        "text": "Halfway through prototyping, a few prototypes had not worked and the team was still experimenting with ideas such as a one-bar intake.",
        "basis": "team",
        "src": [
          "s8"
        ]
      }
    ],
    "outcome": [
      {
        "text": "46-21-0 in official play; won the Curie division; captain of the Curie alliance on Einstein; ranked 13 of the pooled top 20 (OPR 54.44, Curie).",
        "basis": "record",
        "src": [
          "s1",
          "s2"
        ]
      }
    ]
  },
