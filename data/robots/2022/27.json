  "story": {
    "cycle": [
      {
        "text": "The intake takes cargo over the bumpers and guides lead it into the hopper, where an indexer wheel holds one ball so two can wait. One button starts the shot: the Limelight sets hood angle, wheel speed and the robot's heading, the wheels spin up, and a clutch lets the rest of the hopper feed.",
        "basis": "team",
        "src": [
          "s10"
        ]
      }
    ],
    "endgame": [
      {
        "text": "The climber lifts, clamps the second bar with pneumatic claws, swings to the third bar, clamps, releases and repeats to the fourth, like a person on monkey bars. The team's page gives 8 seconds for a traversal climb.",
        "basis": "team",
        "src": [
          "s10",
          "s4"
        ]
      }
    ],
    "fallback": [
      {
        "text": "A partner's coach recalls a state championship match in which something on 27 was not working: 27 offered to draw the opponents' defense and keep it away from the other scorers.",
        "basis": "observer",
        "src": [
          "s8"
        ]
      }
    ],
    "changed": [
      {
        "text": "Climber reduction was 196:1 at the reveal, with room for improvement; the team's season page gives 163:1. The first intake material was too rigid and became polycarbonate. Hopper and intake went through many iterations to get the ball to the right spot.",
        "basis": "team",
        "src": [
          "s11",
          "s4",
          "s10"
        ]
      }
    ],
    "outcome": [
      {
        "text": "78-12-2 in official play; ranked 9 of the pooled top 20 (OPR 59.82, Newton).",
        "basis": "record",
        "src": [
          "s1",
          "s2"
        ]
      }
    ]
  },
