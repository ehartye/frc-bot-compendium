  "decisions": [
    {
      "choice": "Flywheel shooter",
      "because": "the catapult prototype was not quite fast enough to score two cargo comfortably, loading might be a challenge, and the team lacked the bandwidth",
      "instead_of": "a pneumatic double catapult",
      "basis": "team",
      "src": [
        "s27"
      ]
    },
    {
      "choice": "No turret",
      "because": "the team thought it likely unnecessary complexity: most of a cycle is transit, pickup or scoring near the goal",
      "basis": "team",
      "src": [
        "s24"
      ]
    },
    {
      "choice": "Intake and shooter on opposite sides",
      "because": "it makes the auto routines much simpler",
      "basis": "team",
      "src": [
        "s29"
      ]
    },
    {
      "choice": "Collect one cargo before the first shots in the five-cargo auto",
      "because": "shooting first waits for the flywheels, and joining the two tarmac balls needs a back-up and turn that is inefficient on a differential drive",
      "instead_of": "shooting the preload at once",
      "basis": "team",
      "src": [
        "s29"
      ]
    },
    {
      "choice": "A flexible intake",
      "because": "the team aimed to deal with twisting without issue rather than prevent it",
      "instead_of": "a rigid intake",
      "basis": "team",
      "src": [
        "s39"
      ]
    },
    {
      "choice": "Drive the hood by a belt at its pivot",
      "because": "the shooter sits near the frame perimeter and the existing hood left little room behind it",
      "instead_of": "a printed rack and pinion",
      "cost": "a crushed printed pulley and belt slip; a future hood would more than likely be rack and pinion",
      "basis": "team",
      "src": [
        "s31",
        "s35"
      ]
    },
    {
      "choice": "Linear interpolation of tuned shots",
      "because": "it is simpler and follows the tuning closely at the edges of the range",
      "instead_of": "the previous year's regressions",
      "basis": "team",
      "src": [
        "s32"
      ]
    },
    {
      "choice": "Run the climb on a timed sequence",
      "because": "the swing is predictable, and a gyro condition could stop the sequence",
      "instead_of": "using the robot's pitch",
      "basis": "team",
      "src": [
        "s38"
      ]
    },
    {
      "choice": "Passive tilting hooks",
      "because": "they avoid any pneumatics on the high and traversal system",
      "basis": "team",
      "src": [
        "s36"
      ]
    },
    {
      "choice": "Go back to the Limelight software",
      "because": "PhotonVision gave camera trouble, low frame rates and failed connections, and Limelight now provided corner data",
      "instead_of": "PhotonVision on the Limelight",
      "basis": "team",
      "src": [
        "s28"
      ]
    }
  ],
