    {
      "name": "Wrong-ball rejection",
      "does": [
        "sense",
        "deliver"
      ],
      "type": "color sensing with aimed ejection",
      "pieces": [
        "cargo"
      ],
      "serves": [],
      "solves": [
        {
          "text": "Keep collecting while opponent cargo goes where opponents reach it with difficulty",
          "basis": "team",
          "src": [
            "s18",
            "s26"
          ]
        }
      ],
      "facts": [
        {
          "text": "Two REV color sensors feed a Teensy, which sends one PWM signal with the red to blue ratio",
          "basis": "team",
          "src": [
            "s8"
          ]
        },
        {
          "text": "Thresholds stay on the roboRIO so the Teensy code never has to change",
          "basis": "team",
          "src": [
            "s44"
          ]
        },
        {
          "text": "Aimed ejection uses gyro, encoders and Limelight to send opponent cargo to places such as the hangar or the team's alliance wall",
          "basis": "team",
          "src": [
            "s26",
            "s27"
          ]
        },
        {
          "text": "Where the hub is in the way or the turret cannot reach, it does a normal soft eject",
          "basis": "team",
          "src": [
            "s27",
            "s45"
          ]
        }
      ],
      "cost": [
        {
          "text": "The first version ignored robot velocity and could throw balls off the field",
          "basis": "team",
          "src": [
            "s27"
          ]
        }
      ]
    },
    {
      "name": "Goal tracking",
      "does": [
        "sense"
      ],
      "type": "Limelight with a remembered goal position",
      "serves": [
