            "s46"
          ],
          "value": 250,
          "unit": "ms"
        }
      ]
    },
    {
      "name": "Shooting on the fly",
      "does": [
        "sense",
        "position"
      ],
      "type": "turret feedforward plus regression",
      "pieces": [
        "cargo"
      ],
      "serves": [
        "hub-upper"
      ],
      "solves": [
        {
          "text": "Shoot while moving, with the turret always lined up",
          "basis": "team",
          "src": [
            "s8"
          ]
        }
      ],
      "facts": [
        {
          "text": "Turret feedforward comes from robot rotation and angular velocity relative to the goal",
          "basis": "team",
          "src": [
            "s8"
          ]
        },
        {
          "text": "Wheel speed and hood angle come from a linear regression on the ball's vertical and horizontal velocity",
          "basis": "team",
          "src": [
            "s8"
          ]
        },
        {
          "text": "The driver has an allow-shoot button; the robot fires when turret, hood and wheel speed are right",
          "basis": "team",
          "src": [
            "s19"
          ]
        }
      ],
      "cost": [
        {
          "text": "Sudden acceleration during the feed could spoil a shot; the team relied on driver practice",
          "basis": "team",
          "src": [
            "s19"
          ]
        }
      ]
    },
    {
      "name": "Autonomous path following",
      "does": [
        "sense",
        "drive"
      ],
      "type": "quintic Hermite splines",
      "serves": [
        "taxi",
        "hub-upper"
      ],
      "solves": [
        {
          "text": "Follow paths smoothly and reliably",
          "basis": "team",
          "src": [
            "s8"
          ]
        }
      ],
      "facts": [
        {
          "text": "Splines are optimized for small curvature change to limit torque, slip and inaccuracy",
          "basis": "team",
          "src": [
            "s8"
          ]
        },
        {
          "text": "Feedforward from precomputed velocity plus proportional feedback on position and heading",
          "basis": "team",
          "src": [
            "s8"
          ]
        }
      ]
    }
