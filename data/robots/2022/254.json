  "decisions": [
    {
      "choice": "Swerve",
      "because": "the field was flat and open, and earlier barriers to swerve were gone",
      "instead_of": "the West Coast drives of the past 20 years",
      "basis": "team",
      "src": [
        "s47",
        "s18",
        "s8"
      ]
    },
    {
      "choice": "React against the truss and skip the high rung",
      "because": "reacting on the high bar needed a large swept space, and climbing below the truss may leave room for a third robot",
      "instead_of": "a high bar reaction like 125's",
      "basis": "team",
      "src": [
        "s18"
      ]
    },
    {
      "choice": "Grip tape on polycarbonate rollers",
      "because": "it saved a few pounds on each intake and still worked",
      "instead_of": "flex wheels",
      "basis": "team",
      "src": [
        "s18"
      ]
    },
    {
      "choice": "Eject opponent cargo through the shooter",
      "because": "the intakes can keep collecting",
      "instead_of": "ejecting through the intake",
      "basis": "team",
      "src": [
        "s18"
      ]
    },
    {
      "choice": "A 9 in flywheel",
      "because": "its long acceleration is consistent with balls in different condition",
      "instead_of": "much smaller Fairlane wheels",
      "basis": "team",
      "src": [
        "s18"
      ]
    },
    {
      "choice": "One motor on the elevator",
      "because": "it gained over a pound for the new hooded shooter",
      "instead_of": "two motors at 11.5:1",
      "basis": "team",
      "src": [
        "s25"
      ]
    },
    {
      "choice": "Keep pneumatic intakes",
      "because": "motorizing them was too big a change in mid-season",
      "instead_of": "motorized intakes for faster deploy and retract",
      "basis": "team",
      "src": [
        "s35"
      ]
    },
    {
      "choice": "Solid 1/8 in bellypan",
      "because": "low center of gravity, free mounting holes and less dust pulled into the robot",
      "instead_of": "a pocketed pan",
      "cost": "weight, fought all season, and dirt that could not be blown out through the pan",
      "basis": "team",
      "src": [
        "s23"
      ]
    },
    {
      "choice": "Stacked polycarbonate funnel wheels",
      "because": "they worked as well and saved at least another 0.5 lb across the robot",
      "instead_of": "6 in omni wheels, whole or sawn in half",
      "basis": "team",
      "src": [
        "s26"
      ]
    },
    {
      "choice": "REV color sensors through a Teensy",
      "because": "the industrial sensors were annoying to calibrate and less accurate than wanted, and other teams had issues with the roboRIO I2C port",
      "instead_of": "industrial color sensors",
      "basis": "team",
      "src": [
        "s18"
      ]
    },
    {
      "choice": "In playoffs, fetch the hard-to-reach cargo early",
      "because": "it comes back into play later as easy cargo",
      "basis": "team",
      "src": [
        "s3"
      ]
    }
  ],
