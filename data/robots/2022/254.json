      "facts": [
        {
          "text": "Limelight 2+; target corners and known height give the goal's position, kept and smoothed all match even when unseen",
          "basis": "team",
          "src": [
            "s8"
          ]
        },
        {
          "text": "Old tracks were weighted heavily against false targets, which failed after wheel slip; the robot then switched after seeing a new target for",
          "basis": "team",
