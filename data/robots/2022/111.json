  "story": {
    "auto": [
      {
        "text": "A five-ball program much like the standard one, parked slightly farther from the human player station so its ramp would not interfere with the intake. Of four two-ball programs ready to run, three also took opposing cargo, to hide it beside the hub, shoot it into the team's hangar, or (blue alliance only) displace a ball to score a third.",
        "basis": "team",
        "src": [
          "s13"
        ]
      }
    ],
    "cycle": [
      {
        "text": "Polybelt and a roller pull cargo over the bumper into the feed, which shuts off at two balls.",
        "basis": "team",
        "src": [
          "s12"
        ]
      },
      {
        "text": "The Limelight's distance sets hood angle and flywheel speed while the robot takes over rotation to aim. The team also shot while moving, at limited speed.",
        "basis": "team",
        "src": [
          "s13"
        ]
      }
    ],
    "endgame": [
      {
        "text": "Hooks rise, the robot drives into the bar, and they pull down until flip-up hooks hold the robot. The hooks go up again, come back in and pull down, repeating as far as the traversal.",
        "basis": "team",
        "src": [
          "s12"
        ]
      },
      {
        "text": "The operator controlled every part of the climb by hand.",
        "basis": "team",
        "src": [
          "s13"
        ]
      }
    ],
    "gave_up": [
      {
        "text": "Without a turret, shooting while moving ended up simplistic, and speed had to be limited or the target would leave the Limelight's field of view.",
        "basis": "team",
        "src": [
          "s13"
        ]
      }
    ],
    "changed": [
      {
        "text": "Two extra intake wheels and a support bar where cargo got stuck were removed; a kicker wheel was added to the shooter for more consistent shots.",
        "basis": "team",
        "src": [
          "s12"
        ]
      },
      {
        "text": "Orange flags went on the climber after robots were seen falling off the hangar.",
        "basis": "team",
        "src": [
          "s7"
        ]
      },
      {
        "text": "The robot went through three intakes in eliminations at its first event.",
        "basis": "team",
        "src": [
          "s18"
        ]
      }
    ],
    "outcome": [
      {
        "text": "42-5-0 in official play; ranked 13 of the pooled top 20 (OPR 58.10, Newton).",
        "basis": "record",
        "src": [
          "s1",
          "s2"
        ]
      }
    ]
  },
  "functions": [
    {
      "name": "Swerve drive",
      "solves": [
        {
          "text": "Be fast without being unstable, and give the driver one less thing to worry about",
          "basis": "team",
          "src": [
            "s13"
          ]
        }
      ],
      "does": [
        "drive"
      ],
      "type": "swerve",
      "serves": [],
      "facts": [
        {
          "text": "SDS MK3 modules, with no issues in 2021 and 2022",
          "basis": "team",
          "src": [
            "s10",
            "s20"
          ]
        },
        {
          "text": "The code release calls the modules SDS MKIIs",
          "basis": "team",
          "src": [
            "s13"
          ]
        },
        {
          "text": "Square frame side",
          "basis": "team",
          "src": [
            "s15"
          ],
          "value": 26,
          "unit": "in"
        },
        {
          "text": "The translation stick gives up to 60% of available power and a trigger unlocks the last 40%",
          "basis": "team",
          "src": [
            "s13"
          ]
        },
        {
          "text": "Heading-lock buttons turn the robot to a cardinal direction or to a hub angle for shots against the hub",
          "basis": "team",
          "src": [
            "s13"
          ]
        },
        {
          "text": "Snake mode points the intake where the robot is moving, mostly for grabbing cargo while crossing the field",
          "basis": "team",
          "src": [
            "s13"
          ]
        },
        {
          "text": "A camera and robot-centric control, with slower rotation, serve pickups in the blind spot behind the hub",
          "basis": "team",
          "src": [
            "s13"
          ]
        }
      ]
    },
    {
      "name": "Steel belly plate and clean frame",
      "solves": [
        {
          "text": "Push the center of gravity lower",
          "basis": "team",
          "src": [
            "s14"
          ]
        }
      ],
      "does": [
        "structure"
      ],
      "type": "ballast and packaging",
      "serves": [],
      "facts": [
        {
          "text": "Steel plate on the bottom, about 13 x 26 x 0.100 in",
          "basis": "team",
          "src": [
            "s16"
          ]
        },
        {
          "text": "Weight was 108 before ballast and 118 and change after",
          "basis": "team",
          "src": [
            "s14"
          ]
        },
        {
          "text": "Center of gravity is about 9 in high per Onshape",
          "basis": "team",
          "src": [
            "s15"
          ]
        },
        {
          "text": "No brackets on the outside of the frame; the intake plate used a printed mount on the top of the rail",
          "basis": "team",
          "src": [
            "s19"
          ]
        },
        {
          "text": "Motors on the robot of the year before, per a 2023 post, with pneumatics and four CAN encoders; the post does not name which of the two teams' robots",
          "basis": "team",
          "src": [
            "s21"
          ],
          "value": 18,
          "unit": "motors"
        }
      ]
    },
    {
      "name": "Intake",
      "pieces": [
        "cargo"
      ],
      "solves": [
        {
          "text": "Pick up cargo without dead zones or pinching points",
          "basis": "team",
          "src": [
            "s12"
          ]
        }
      ],
      "cost": [
        {
          "text": "Defense at the first event broke the intake multiple times",
          "basis": "team",
          "src": [
            "s24"
          ]
        }
      ],
      "does": [
        "acquire"
      ],
      "type": "over-bumper compliant wheel intake",
      "serves": [],
      "facts": [
        {
          "text": "Early prototypes used compliant wheels of about 2 in and quite different geometry",
          "basis": "team",
          "src": [
            "s12"
          ]
        },
        {
          "text": "Cargo got stuck beside two additional compliant wheels; removing them fixed it",
          "basis": "team",
          "src": [
            "s12"
          ]
        },
        {
          "text": "A support bar at the back was removed because cargo was pushed up and pinched there when the wheels ran backward or at the wrong speed",
          "basis": "team",
          "src": [
            "s12"
          ]
        },
        {
          "text": "Intake wheels were replaced in week 7 for better grip",
          "basis": "team",
          "src": [
            "s23"
          ]
        },
        {
          "text": "Asked for intake details, the team gave a NEO with a 3:1 belt reduction",
          "basis": "team",
          "src": [
            "s20"
          ]
        }
      ]
    },
    {
      "name": "Feed system",
      "pieces": [
        "cargo"
      ],
      "solves": [
        {
          "text": "Keep cargo out of the shooter until wanted, and not pick up more than two",
          "basis": "team",
          "src": [
            "s12"
          ]
        }
      ],
      "does": [
        "transfer",
        "retain",
        "sense"
      ],
      "type": "polybelt feed with pneumatic kicker",
      "serves": [],
      "facts": [
        {
          "text": "Polybelt on both sides and a roller pull the ball over the bumper, then over a polycarbonate sheet",
          "basis": "team",
          "src": [
            "s12"
          ]
        },
        {
          "text": "A pneumatic kicker lets cargo rotate in the feed; the piston takes it back down so cargo can go up to the shooter",
          "basis": "team",
          "src": [
            "s12"
          ]
        },
        {
          "text": "A kicker motor regulates the speed at which cargo goes to the flywheel and made shots more consistent",
          "basis": "team",
          "src": [
            "s12"
          ]
        },
        {
          "text": "Sensors that find cargo in the ball path",
          "basis": "team",
          "src": [
            "s13"
          ],
          "value": 2,
          "unit": "banner sensors"
        },
        {
          "text": "With two balls sensed the feed motors shut off at once, so cargo is not pushed through the pneumatic gate",
          "basis": "team",
          "src": [
            "s12"
          ]
        }
      ]
    },
    {
      "name": "Shooter with adjustable hood",
      "pieces": [
        "cargo"
      ],
      "solves": [
        {
          "text": "Reduce top spin so balls are less likely to bounce out",
          "basis": "team",
          "src": [
            "s12"
          ]
        }
      ],
      "does": [
        "deliver"
      ],
      "type": "flywheel shooter with adjustable hood, no turret",
      "serves": [],
      "facts": [
        {
          "text": "Colson wheels, chosen to be light and to spin up faster than the team's 2020 wheels",
          "basis": "team",
          "src": [
            "s12"
          ]
        },
        {
          "text": "Stealth wheels at the back reduce top spin",
          "basis": "team",
          "src": [
            "s12"
          ]
        }
      ]
    },
    {
      "name": "Limelight aiming",
      "pieces": [
        "cargo"
      ],
      "solves": [
        {
          "text": "Make the shot from a range of distances without a turret",
          "basis": "team",
          "src": [
            "s13"
          ]
        }
      ],
      "does": [
        "sense",
        "position"
      ],
      "type": "vision aiming with the drivetrain",
      "serves": [],
      "facts": [
        {
          "text": "The robot takes over the rotation stick to aim at the goal",
          "basis": "team",
          "src": [
            "s13"
          ]
        },
        {
          "text": "Distance goes into two piecewise quadratic regressions, for hood angle and flywheel speed",
          "basis": "team",
          "src": [
            "s13"
          ]
        },
        {
          "text": "The regressions come from a few points between the inside of the tarmac and the alliance station wall",
          "basis": "team",
          "src": [
            "s13"
          ]
        },
        {
          "text": "For shots on the move, the distance and target angle are altered by the translation stick values; a static horizontal offset was tried first",
          "basis": "team",
          "src": [
            "s13"
          ]
        },
        {
          "text": "The team calls the moving shot fairly successful because the goal is large",
          "basis": "team",
          "src": [
            "s13"
          ]
        }
      ]
    },
    {
      "name": "Auto path follower",
      "does": [
        "sense",
        "drive"
      ],
      "type": "custom path following",
      "serves": [],
      "facts": [
        {
          "text": "Follows BobTrajectory paths: the path's direction sets the translation and a control loop holds the heading",
          "basis": "team",
          "src": [
            "s13"
          ]
        },
        {
          "text": "Feedforward comes from two tests: power to overcome friction, and power to velocity",
          "basis": "team",
          "src": [
            "s13"
          ]
        },
        {
          "text": "Robot coordinates came from sketches in Onshape",
          "basis": "team",
          "src": [
            "s13"
          ]
        }
      ]
    },
    {
      "name": "Climber",
      "solves": [
        {
          "text": "Climb to the traversal while keeping the drive base small",
          "basis": "team",
          "src": [
            "s12"
          ]
        }
      ],
      "cost": [
        {
          "text": "Cabling wrapped at different diameters under load, so encoder values did not match climber position",
          "basis": "team",
          "src": [
            "s13"
          ]
        },
        {
          "text": "The two-team program says its printed climber pulleys without sleeves were crushed in 2022; the post does not say on which robot",
          "basis": "team",
          "src": [
            "s22"
          ]
        }
      ],
      "does": [
        "endgame"
      ],
      "type": "hook climber with flip-up holding hooks",
      "serves": [
        "rung-traversal"
      ],
      "facts": [
        {
          "text": "Moving hooks pull the bar past hooks that flip up and then hold the robot",
          "basis": "team",
          "src": [
            "s12"
          ]
        },
        {
          "text": "The climber hook was being modified in week 7",
          "basis": "team",
          "src": [
            "s23"
          ]
        },
        {
          "text": "Orange flags show the driver and operator where the robot is, to help center on the hangar",
          "basis": "team",
          "src": [
            "s7"
          ]
        },
        {
          "text": "With enough practice, manual control was error-free",
          "basis": "team",
          "src": [
            "s13"
          ]
        }
      ]
    }
  ],
  "decisions": [
    {
      "choice": "Pick the climber that keeps the drive base small",
      "because": "a really small drive base can get around anywhere on the field",
      "basis": "team",
      "src": [
        "s12"
      ]
    },
    {
      "choice": "No turret",
      "because": "the swerve drive and Limelight already aim the robot",
      "cost": "shooting while moving was simplistic and had to be slow enough to keep the target in view",
      "basis": "team",
      "src": [
        "s12",
        "s13"
      ]
    },
    {
      "choice": "Manual operator control of the climb",
      "because": "the automation had issues from encoder values that did not match climber position",
      "instead_of": "an automated state system",
      "basis": "team",
      "src": [
        "s13"
      ]
    },
    {
      "choice": "Open-loop auto driving",
      "because": "it was accurate, and the drive team got more time to practice",
      "instead_of": "encoder feedback",
      "basis": "team",
      "src": [
        "s13"
      ]
    },
    {
      "choice": "Steel ballast plate",
      "because": "it pushes the center of gravity lower",
      "basis": "team",
      "src": [
        "s14",
        "s16"
      ]
    },
    {
      "choice": "Bumpers that mount from underneath",
      "because": "it was easy",
      "cost": "the team calls the mount kinda terrible",
      "basis": "team",
      "src": [
        "s17"
      ]
    }
  ],
