  "decisions": [
    {
      "choice": "Swerve and a turret together",
      "because": "of predictive shooting and being able to intake and shoot at any orientation under defense",
      "basis": "team",
      "src": [
        "s6"
      ]
    },
    {
      "choice": "L4 drive ratio",
      "because": "an L2 tested before the season was not enough for its demands for a fast, maneuverable robot, L3 was out of stock, and the robot would be small and light enough",
      "instead_of": "L2 or L3",
      "basis": "team",
      "src": [
        "s13"
      ]
    },
    {
      "choice": "Deploy the intake passively and leave it down",
      "because": "it is simple, and a deployment system was one more failure point that could cost ranking points",
      "instead_of": "a retracting intake",
      "cost": "some minor penalties at district events",
      "basis": "team",
      "src": [
        "s16"
      ]
    },
    {
      "choice": "Mount the modules under the frame tube",
      "because": "a shorter cargo shelf lowers the whole ball path and leaves room for the battery box and climber gearbox",
      "instead_of": "modules on top",
      "basis": "team",
      "src": [
        "s14"
