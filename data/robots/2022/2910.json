  "story": {
    "bet": [
      {
        "text": "One adjustable hood that both shoots cargo and climbs the hangar, on a really short compact robot.",
        "basis": "team",
        "src": [
          "s36",
          "s15",
          "s13"
        ]
      }
    ],
    "demand": [
      {
        "text": "The team listed a high hub shooter, a traversal climb, multi-ball autos, and simple one-driver teleop with lots of automation.",
        "basis": "team",
        "src": [
          "s3"
        ]
      },
      {
        "text": "It wanted the climb automated from the very beginning, to mitigate human error and keep one driver.",
        "basis": "team",
        "src": [
          "s35"
        ]
      }
    ],
    "auto": [
      {
        "text": "Nine autonomous modes with different starting positions and cargo counts, for compatibility with partners.",
        "basis": "team",
        "src": [
          "s4"
        ]
      },
      {
        "text": "A six-ball auto ran in a match at Bonney Lake; the path drives through the hangar to get behind the sixth ball.",
        "basis": "team",
        "src": [
          "s21",
          "s20"
        ]
      }
    ],
    "cycle": [
      {
        "text": "A mecanum wheel intake takes cargo in, and a feeder driven by long belts from a rear motor carries it up to the shooter.",
        "basis": "team",
        "src": [
          "s35",
          "s36"
        ]
      },
      {
        "text": "Shooting uses vision targeting and interpolation.",
        "basis": "team",
        "src": [
          "s4"
        ]
      },
      {
        "text": "A heavy flywheel keeps enough energy to shoot two in a row.",
        "basis": "team",
        "src": [
          "s35"
        ]
      }
    ],
    "endgame": [
      {
        "text": "The telescopes rise over the mid bar and lower so the driver can check both hooks, then one button runs the climb in about seven seconds.",
        "basis": "team",
        "src": [
          "s35"
        ]
      },
      {
        "text": "Hooking the hood on the top bar is not needed to score; the team did it a lot at championships to leave room for partners.",
        "basis": "team",
        "src": [
          "s14",
          "s22"
        ]
      }
    ],
    "fallback": [
      {
        "text": "Dashboard sliders change shooter tuning mid-match, and a chooser picks one of six climb stages from a mid rung hang to traversal.",
        "basis": "team",
        "src": [
          "s4"
        ]
      },
      {
        "text": "After losing its shooter belt in a Bonney Lake match, the team played some defense.",
        "basis": "team",
        "src": [
          "s21"
        ]
      }
    ],
    "gave_up": [
      {
        "text": "Shooting from the intake side was a packaging compromise for a really short, compact robot whose hood needs a ton of wrap for the climb.",
        "basis": "team",
        "src": [
          "s15"
        ]
      },
      {
        "text": "One-piece side plates make changes a bit more difficult and need lots of double checking.",
        "basis": "team",
        "src": [
          "s30"
        ]
      }
    ],
    "changed": [
      {
        "text": "At the SunDome event the climber dented at every traverse and was undented after every match; it was redesigned in thicker aluminum.",
        "basis": "team",
        "src": [
          "s35"
        ]
      },
      {
        "text": "Climb gearing went from about 19.6:1 to 13.2:1 to speed up the sequence.",
        "basis": "team",
        "src": [
          "s33"
        ]
      },
      {
        "text": "In April the team had power to go faster but risked jumping off the bars.",
        "basis": "team",
        "src": [
          "s19"
        ]
      }
    ],
    "outcome": [
      {
        "text": "86-8-0 in official play; won the Newton division; captain of the Newton alliance on Einstein; ranked 11 of the pooled top 20 (OPR 58.93, Newton).",
        "basis": "record",
        "src": [
          "s1",
          "s2"
        ]
      }
    ]
  },
  "functions": [
    {
      "name": "Swerve drivetrain",
      "solves": [
        {
          "text": "Keep the center of gravity really low",
          "basis": "team",
          "src": [
            "s35"
          ]
        }
      ],
      "cost": [
        {
          "text": "The team calls the weight more than most would expect and says some design practices need adjusting for a full size robot",
          "basis": "team",
          "src": [
            "s27"
          ]
        }
      ],
      "does": [
        "drive",
        "structure"
      ],
      "type": "swerve",
      "serves": [],
      "facts": [
        {
          "text": "SDS MK4i modules with Falcon 500 motors, at the L3 ratio",
          "basis": "team",
          "src": [
            "s36",
            "s34"
          ]
        },
        {
          "text": "Motors are flipped to hang down into the frame",
          "basis": "team",
          "src": [
            "s35"
          ]
        },
        {
          "text": "Frame perimeter 26 in x 26 in; 24 in tall with hood and climber down",
          "basis": "team",
          "src": [
            "s3"
          ]
        },
        {
          "text": "Weight at championships without battery and bumpers",
          "basis": "team",
          "src": [
            "s27"
          ],
          "value": 112,
          "unit": "lb"
        },
        {
          "text": "The team tried no other ratio and thinks it would have been very happy with L2 as well",
          "basis": "team",
          "src": [
            "s34"
          ]
        }
      ]
    },
    {
      "name": "Intake",
      "pieces": [
        "cargo"
      ],
      "solves": [
        {
          "text": "Grip and take in cargo quickly",
          "basis": "team",
          "src": [
            "s29",
            "s36"
          ]
        }
      ],
      "does": [
        "acquire"
      ],
      "type": "mecanum wheel intake",
      "serves": [
        "hub-upper"
      ],
      "facts": [
        {
          "text": "4 in mecanum wheels; the team listed it as a \"VIW intake\"",
          "basis": "team",
          "src": [
            "s29",
            "s3"
          ]
        },
        {
          "text": "Compliant wheels were also prototyped",
          "basis": "team",
          "src": [
            "s35"
          ]
        },
        {
          "text": "Powered by Falcons with 3D printed pulleys; the pneumatics are said to be unchanged from 2021",
          "basis": "team",
          "src": [
            "s35"
          ]
        }
      ]
    },
    {
      "name": "Feeder",
      "pieces": [
        "cargo"
      ],
      "solves": [
        {
          "text": "Move cargo to the shooter in very little space",
          "basis": "team",
          "src": [
            "s35"
          ]
        }
      ],
      "does": [
        "transfer"
      ],
      "type": "top-driven belt feeder",
      "serves": [
        "hub-upper"
      ],
      "facts": [
        {
          "text": "Powered only on the top, so the path runs across the battery and saves space",
          "basis": "team",
          "src": [
            "s35"
          ]
        },
        {
          "text": "Its motor sits at the back with long belts, where there was room",
          "basis": "team",
          "src": [
            "s35"
          ]
        }
      ]
    },
    {
      "name": "Shooter and hood",
      "pieces": [
        "cargo"
      ],
      "solves": [
        {
          "text": "Shoot two cargo back to back from a hood that also serves as climbing hooks",
          "basis": "team",
          "src": [
            "s35",
            "s36"
          ]
        }
      ],
      "cost": [
        {
          "text": "The shooter belt came off in a match when another robot popped a wheelie onto Thor",
          "basis": "team",
          "src": [
            "s21"
          ]
        }
      ],
      "does": [
        "deliver",
        "position"
      ],
      "type": "flywheel with adjustable 3D printed hood",
      "serves": [
        "hub-upper"
      ],
      "facts": [
        {
          "text": "The hood turns about 90 degrees only for the climb; shooting uses about 30 degrees",
          "basis": "team",
          "src": [
            "s13"
          ]
        },
        {
          "text": "Compression at the shooter, roughly",
          "basis": "team",
          "src": [
            "s35"
          ],
          "value": 1,
          "unit": "in"
        },
        {
          "text": "The hood is Onyx, printed in two parts to fit the bed",
          "basis": "team",
          "src": [
            "s18"
          ]
        },
        {
          "text": "Hood rack and pinion reuse Vex 10DP gear profiles, scaled slightly",
          "basis": "team",
          "src": [
            "s32"
          ]
        },
        {
          "text": "The hood was a five-day print; at the championship the team said it had never needed the backup",
          "basis": "team",
          "src": [
            "s35"
          ]
        }
      ]
    },
    {
      "name": "Climber",
      "solves": [
        {
          "text": "Climb from a really short retracted height with very generous stage overlap when extended",
          "basis": "team",
          "src": [
            "s16"
          ]
        }
      ],
      "cost": [
        {
          "text": "At SunDome it dented at every traverse and had to be taken apart and undented after every match",
          "basis": "team",
          "src": [
            "s35"
          ]
        }
      ],
      "does": [
        "endgame"
      ],
      "type": "multi-stage telescopes plus hood hooks",
      "serves": [
        "rung-mid",
        "rung-high",
        "rung-traversal"
      ],
      "facts": [
        {
          "text": "Each stage has four 2.3 lb constant force springs per telescope, about 18.4 lb over both telescopes less stage weight",
          "basis": "team",
          "src": [
            "s25",
            "s26"
          ]
        },
        {
          "text": "Geared 13.2:1 on a pulley of about 2 in diameter",
          "basis": "team",
          "src": [
            "s25"
          ]
        },
        {
          "text": "Spring-loaded hooks hold it down until the robot homes it, because the springs can back-drive the gearboxes with power off",
          "basis": "team",
          "src": [
            "s24"
          ]
        },
        {
          "text": "3D printed spools hide the string's knot in a pocket and lay it in a helical groove",
          "basis": "team",
          "src": [
            "s17"
          ]
        },
        {
          "text": "Fully automated traversal climb time",
          "basis": "team",
          "src": [
            "s4"
          ],
          "value": 7,
          "unit": "s"
        }
      ]
    },
    {
      "name": "Aiming and autonomous software",
      "pieces": [
        "cargo"
      ],
      "solves": [
        {
          "text": "Aim shots and fit different partners' autos",
          "basis": "team",
          "src": [
            "s4"
          ]
        }
      ],
      "does": [
        "sense"
      ],
      "type": "vision interpolation and SolidWorks-drawn paths",
      "serves": [
        "hub-upper"
      ],
      "facts": [
        {
          "text": "Vision targeting with interpolation for shooting",
          "basis": "team",
          "src": [
            "s4"
          ]
        },
        {
          "text": "Paths are drawn as lines and arcs on a SolidWorks field model, and the coordinates go into the code",
          "basis": "team",
          "src": [
            "s4"
          ]
        }
      ]
    },
    {
      "name": "Parallel plate structure",
      "solves": [
        {
          "text": "Assemble very quickly from parts a router sponsor cuts",
          "basis": "team",
          "src": [
            "s30"
          ]
        }
      ],
      "cost": [
        {
          "text": "Changes are a bit more difficult, so belt center distances must be right before the plates are made",
          "basis": "team",
          "src": [
            "s30"
          ]
        }
      ],
      "does": [
        "structure"
      ],
      "type": "one-piece routed side plates",
      "serves": [],
      "facts": [
        {
          "text": "The whole robot is built like a big parallel plate gearbox",
          "basis": "team",
          "src": [
            "s30"
          ]
        },
        {
          "text": "Long 3/8 in standoffs are cut from Vex shaft stock, then faced and tapped",
          "basis": "team",
          "src": [
            "s28"
          ]
        },
        {
          "text": "Many smaller plates were remade as the design iterated, usually on a Brother Speedio to get a one-day turn",
          "basis": "team",
          "src": [
            "s37"
          ]
        }
      ]
    }
  ],
  "decisions": [
    {
      "choice": "Shoot from the intake side",
      "because": "it was a packaging compromise: the team wanted a really short compact robot and the hood needs a ton of wrap for the climb",
      "basis": "team",
      "src": [
        "s15"
      ]
    },
    {
      "choice": "Short multi-stage climber",
      "because": "it gives a really short retracted height with very generous stage overlap when extended",
      "basis": "team",
      "src": [
        "s16"
      ]
    },
    {
      "choice": "4 in mecanum intake wheels",
      "because": "they gripped and took in cargo better on a prototyping chassis",
      "instead_of": "2 in single-print wheels, among other types",
      "basis": "team",
      "src": [
        "s29"
      ]
    },
    {
      "choice": "Custom climber gearbox",
