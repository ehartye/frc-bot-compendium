  "decisions": [
    {
      "choice": "High rung climb in season",
      "because": "it took about 5 s against about 15 s, and the extra time could be used to score",
      "instead_of": "the traversal rung",
      "cost": "ranking points",
      "basis": "team",
      "src": [
        "s16"
      ]
    },
    {
      "choice": "Swerve, with no turret",
      "because": "it gives maneuverability against defense, more auto paths and easy aiming",
      "basis": "team",
      "src": [
        "s6"
      ]
    },
    {
      "choice": "Two intakes",
      "because": "two would make autos significantly easier with the six-ball routine (off-season interview)",
      "instead_of": "a first single-intake design",
      "basis": "team",
      "src": [
        "s20"
      ]
    },
    {
      "choice": "Belt-driven climber",
      "because": "constant force springs had caused issues the year before (off-season interview, auto-captions)",
      "basis": "team",
      "src": [
        "s20"
      ]
    },
    {
      "choice": "Its own drive controller in code",
      "because": "the WPILib one does not enable continuous output on heading, and its profiled PID behaved erratically at times (the team never learned whether its own use or the library was at fault)",
      "instead_of": "the WPILib holonomic drive controller",
      "basis": "team",
      "src": [
        "s17"
      ]
    }
  ],
