  "story": {
    "auto": [
      {
        "text": "A five ball auto (preload, three on the terminal side and one from the human player) and a two ball auto, as listed before its third regional.",
        "basis": "team",
        "src": [
          "s3"
        ]
      }
    ],
    "cycle": [
      {
        "text": "Cargo is picked up from the floor over the bumper and goes by conveyor to a turreted shooter. Code sets shooting RPM from distance and uses the Limelight with the turret.",
        "basis": "team",
        "src": [
          "s3",
          "s5"
        ]
      }
    ],
    "endgame": [
      {
        "text": "Climbs to level 2 and level 3, \"return at around 15-10 seconds\", as listed before its third regional. The driver steps through the climb states with a button.",
        "basis": "team",
        "src": [
          "s3",
          "s5"
        ]
      }
    ],
    "fallback": [
      {
        "text": "Manual overrides are always built in, so the robot does not rely on automation if something fails.",
        "basis": "team",
        "src": [
          "s5"
        ]
      }
    ],
    "gave_up": [
      {
        "text": "An opponent says its swerve was dominant over this tank drive during 30 seconds of contact in Newton match 115. It agrees that 973's intake had broken early in that match.",
        "basis": "observer",
        "src": [
          "s8",
          "s7"
        ]
      }
    ],
    "changed": [
      {
        "text": "Off-season (October 2022): a new robot used swerve, timing belts instead of the polycord indexer, omni wheels to funnel balls, a bar to stop balls sticking in the intake, and a shooter moved 1 in forward against unwanted backspin.",
        "basis": "team",
        "src": [
          "s6"
        ]
      }
    ],
    "outcome": [
      {
        "text": "61-16-0 in official play; won the Newton division; pick 1 of the Newton alliance on Einstein; ranked 72 by championship OPR (47.01, Newton).",
        "basis": "record",
        "src": [
          "s1",
          "s2"
        ]
      }
    ]
  },
