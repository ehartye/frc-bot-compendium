  "story": {
    "cycle": [
      {
        "text": "A spectator at the championship says it shot from most anywhere, sometimes while moving, and that shots entered the hub softly with no bounce-out they saw.",
        "basis": "observer",
        "src": [
          "s7"
        ]
      },
      {
        "text": "Another post says it would frequently take opponent balls and sort them into the hangars and terminals.",
        "basis": "observer",
        "src": [
          "s12"
        ]
      }
    ],
    "gave_up": [
      {
        "text": "A post leaves it out of a list of similar quick climbs because its reach from the high rung to traversal, without a reverse hook, needed an extra swing.",
        "basis": "observer",
        "src": [
          "s13"
        ]
      }
    ],
    "outcome": [
      {
        "text": "53-7-0 in official play; won the Carver division; pick 1 of the Carver alliance on Einstein; ranked 8 of the pooled top 20 (OPR 60.88, Carver).",
        "basis": "record",
        "src": [
          "s1",
          "s2"
        ]
      }
    ]
  },
